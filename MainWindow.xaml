                        <Grid>

                            <!-- Mode 1: Bento Cards (Tiles) -->
                            <ScrollViewer x:Name="ScrollCoresTiles" VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="PanelCoresTiles" Margin="0,4"/>
                            </ScrollViewer>

                            <!-- Mode 2: Ozone List (Rows) -->
                            <ScrollViewer x:Name="ScrollCoresList" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel x:Name="PanelCoresList" Margin="0,4"/>
                            </ScrollViewer>

                            <!-- Mode 3: Compact Grid (Icons) -->
                            <ScrollViewer x:Name="ScrollCoresCompact" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <WrapPanel x:Name="PanelCoresCompact" Margin="0,4"/>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- VIEW 7:  СЕТЕВАЯ ИГРА -->
                <Grid x:Name="ViewNetplay" Visibility="Collapsed" Margin="22,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Сетевая игра и совместные комнаты" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Совместное прохождение классических игр по локальной сети и через серверы Libretro" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" Margin="0,0,0,16"/>

                            <!-- Host Room -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Создать игровую комнату" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Название комнаты:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtNetplayHostRoom" Text="STORM Room #1"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Порт:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtNetplayHostPort" Text="55435"/>
                                    </Grid>
                                    <Button Content="Запустить сервер комнаты" Style="{StaticResource StormAccentButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnStartNetplayHost_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Join Room -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Подключиться к комнате" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="IP или домен хоста:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtNetplayJoinIp" Text="127.0.0.1"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Порт:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtNetplayJoinPort" Text="55435"/>
                                    </Grid>
                                    <Button Content="Подключиться по IP" Style="{StaticResource StormSecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnJoinNetplay_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- 2.0.0 Rollback Netplay Engine (P2P UDP 64-Frame Buffer) -->
                            <Border x:Name="BdrRollbackNetplayPanel" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                        <Border DockPanel.Dock="Right" Background="#1A10B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRollbackStatus" Text="Готов к P2P-соединению (Кольцевой буфер: 64 кадра)" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="#268B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Fill="#A78BFA" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Движок сетевой игры с откатом кадров (Rollback P2P UDP)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="Кольцевой буфер 64 кадра • Детерминированная синхронизация стейтов • P2P UDP" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Telemetry Strip -->
                                    <Border Background="{DynamicResource ThemeHeader}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#14FFFFFF" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                                    <TextBlock x:Name="TxtRollbackPing" Text="Пинг: 0 мс" Foreground="#60A5FA" FontSize="11.5" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="#14FFFFFF" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                                    <TextBlock x:Name="TxtRollbackFrames" Text="Откатов: 0 к" Foreground="#FBBF24" FontSize="11.5" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Задержка ввода:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="CmbRollbackDelay" Width="120" Height="26" SelectionChanged="CmbRollbackDelay_SelectionChanged">
                                                    <ComboBoxItem Content="0 кадров" IsSelected="True"/>
                                                    <ComboBoxItem Content="1 кадр"/>
                                                    <ComboBoxItem Content="2 кадра"/>
                                                    <ComboBoxItem Content="3 кадра"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Controls -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Button x:Name="BtnRollbackHost" Style="{StaticResource StormAccentButton}" Padding="14,6" Margin="0,0,8,0" Click="BtnRollbackHost_Click" ToolTip="Запустить локальный P2P хост с откатом кадров">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Запустить Rollback хост" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnRollbackConnect" Style="{StaticResource StormSecondaryButton}" Padding="14,6" Margin="0,0,8,0" Click="BtnRollbackConnect_Click" ToolTip="Подключиться к P2P хосту по указанному IP">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Подключиться (P2P UDP)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnRollbackStop" Style="{StaticResource StormSecondaryButton}" Padding="14,6" Click="BtnRollbackStop_Click" ToolTip="Остановить сетевую сессию">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M6 6h12v12H6z" Fill="#FB7185" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Остановить сессию" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Live Netplay Lobby -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Открытые сетевые комнаты" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold"/>
                                        <Button Content="Обновить лобби" Style="{StaticResource StormSecondaryButton}" HorizontalAlignment="Right" Click="BtnRefreshLobby_Click"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="ItemsNetplayLobby">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="10">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Content="Подключиться" Style="{StaticResource StormAccentButton}" DockPanel.Dock="Right" Padding="10,4" Tag="{Binding}" Click="BtnJoinLobbyRoom_Click"/>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding GameName}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="13"/>
                                                                <Border Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0">
                                                                    <TextBlock Text="{Binding CoreName}" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="10.5" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding Username, StringFormat='{}Хост: {0}'}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,14,0"/>
                                                                <TextBlock Text="{Binding Country, StringFormat='{}Регион: {0}'}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="0,0,14,0"/>
                                                                <TextBlock Text="{Binding IpPort, StringFormat='{}Адрес: {0}'}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 8:  СКРИНШОТЫ И ВИДЕО -->
                <Grid x:Name="ViewScreenshots" Visibility="Collapsed" Margin="22,14">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,9">
                                    <TextBlock Text="Галерея скриншотов и захватов" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtScreenshotsDirDisplay" Text="Папка: screenshots/" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Click="BtnSaveInstantReplay_Click" ToolTip="Экспортировать последние 30 секунд геймплея в MP4 / WebM (F7)">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z" Fill="#FB7185" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Сохранить повтор 30 сек (F7)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormAccentButton}" Margin="0,0,8,0" Click="BtnGenerateShowcase_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Создать SHOWCASE.png" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Click="BtnRecordClip_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4z" Fill="#FB7185" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Запись клипа 60 FPS" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormSecondaryButton}" Click="BtnOpenScreenshotsFolder_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#38BDF8" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Папка" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="WrapScreenshots" Margin="0,4"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- VIEW 9:  ИМПОРТ КОНТЕНТА -->
                <Grid x:Name="ViewImport" Visibility="Collapsed" Margin="22,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1160" HorizontalAlignment="Stretch">
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <Button Content="Перейти к читам и тренерам игр" Style="{StaticResource StormAccentButton}" Padding="14,7" FontWeight="Bold" Click="BtnSwitchToCheatsView_Click"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Многодисковые игры, сканер каталогов и патчи образов" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Генератор плейлистов многодисковых игр (.m3u), применение патчей перевода (.ips / .bps) и пакетное сканирование папок" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Card: Инспектор ROM и образов (CRC32 / MD5 / SHA-1) -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Button x:Name="BtnInspectRom" Content="Проверить ROM / образ..." Style="{StaticResource StormAccentButton}" Margin="0,0,8,0" Click="BtnInspectRom_Click"/>
                                            <Button x:Name="BtnCopyRomHashReport" Content="Копировать отчёт" Style="{StaticResource StormSecondaryButton}" Click="BtnCopyRomHashReport_Click"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Инспектор ROM и образов (CRC32 / MD5 / SHA-1)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="Хеширование и идентификация оригинальности дампов, заголовочная инспекция и верификация целостности" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Sunken Hash Readout Grid -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Файл образа:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,3"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtHashFileName" IsReadOnly="True" Height="26" MinHeight="26" Padding="8,0" Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" Margin="0,3" Text="-"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Формат / Размер:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,3"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtHashFormatAndSize" IsReadOnly="True" Height="26" MinHeight="26" Padding="8,0" Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" Margin="0,3" Text="-" Typography.NumeralAlignment="Tabular"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Заголовок ROM:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,3"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtHashHeaderSummary" IsReadOnly="True" Height="26" MinHeight="26" Padding="8,0" Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" Margin="0,3" Text="-"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="CRC32:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,3"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtHashCrc32" IsReadOnly="True" Height="26" MinHeight="26" Padding="8,0" Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" Margin="0,3" Text="-" Typography.NumeralAlignment="Tabular" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentGlow}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="MD5:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,3"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtHashMd5" IsReadOnly="True" Height="26" MinHeight="26" Padding="8,0" Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" Margin="0,3" Text="-" Typography.NumeralAlignment="Tabular"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="SHA-1:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,3"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtHashSha1" IsReadOnly="True" Height="26" MinHeight="26" Padding="8,0" Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" Margin="0,3" Text="-" Typography.NumeralAlignment="Tabular"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 1: Scan Directory -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Сканировать папку с играми" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="Рекурсивно просканировать всю папку с играми и автоматически привязать оптимальные ядра Libretro" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" Margin="0,0,0,12"/>
                                    <Button Content="Выбрать папку для сканирования..." Style="{StaticResource StormAccentButton}" HorizontalAlignment="Left" Click="BtnAddFolder_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Scan Single File -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Добавить отдельный файл игры" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="Добавить один образ игры (.nes, .sfc, .md, .bin, .iso, .chd, .n64, .gba, .zip)" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" Margin="0,0,0,12"/>
                                    <Button Content="Выбрать файл игры..." Style="{StaticResource StormSecondaryButton}" HorizontalAlignment="Left" Click="BtnAddFiles_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Multi-Disc M3U Playlist Generator -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text=" Генератор плейлистов многодисковых игр (.m3u)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="Автоматическое создание единого .m3u плейлиста для PS1, Saturn, Dreamcast, Sega CD и 3DO игр" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Название игры:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtM3uGameTitle" Text="Final Fantasy VII"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtM3uSelectedFiles" Text="Выбрано дисков: 0" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="12" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="Выбрать образы дисков..." Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Click="BtnSelectM3uFiles_Click"/>
