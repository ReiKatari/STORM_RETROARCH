                                        </WrapPanel>
                                        <Button Content="️ Привязать к retroarch.cfg" Style="{StaticResource StormSecondaryButton}" HorizontalAlignment="Left" Click="BtnConfigureAiInCfg_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: RTMP Streaming -->
                                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text=" Прямая видео-трансляция" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Вещание игрового процесса напрямую на серверы Twitch, YouTube или VK Play" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Платформа:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1" x:Name="CmbStreamPlatform" Height="26" SelectionChanged="CmbStreamPlatform_SelectionChanged">
                                                <ComboBoxItem Content="Twitch (rtmp://live.twitch.tv/app/)" Tag="rtmp://live.twitch.tv/app/" IsSelected="True"/>
                                                <ComboBoxItem Content="YouTube Live (rtmp://a.rtmp.youtube.com/live2/)" Tag="rtmp://a.rtmp.youtube.com/live2/"/>
                                                <ComboBoxItem Content="VK Play Live (rtmp://stream.vkplay.live/live/)" Tag="rtmp://stream.vkplay.live/live/"/>
                                            </ComboBox>
                                        </Grid>

                                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Ключ потока:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" x:Name="TxtStreamKey" Text="live_user_key_storm" Height="26"/>
                                        </Grid>
                                        <Button Content=" Сохранить параметры вещания" Style="{StaticResource StormAccentButton}" HorizontalAlignment="Left" Click="BtnSaveStreamSettings_Click"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Card 3: FFmpeg Video Capture -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text=" Аппаратная видеозапись игры" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Захват высококачественного геймплея со сканлайнами, шейдерами и многоканальным звуком" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,12"/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Контейнер видео:" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="0,0,0,4"/>
