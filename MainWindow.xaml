                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                <Border Width="30" Height="30" CornerRadius="8" Background="#2034D399" BorderBrush="#6034D399" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path Data="M12 3v9.28a4.39 4.39 0 0 0-1.5-.28C8.01 12 6 14.01 6 16.5S8.01 21 10.5 21c2.31 0 4.2-1.75 4.45-4H15V6h4V3h-7z" Fill="#34D399" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Акустическая студия Audio DSP и динамический лимитер" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Студийная эквализация, расширение стереопанорамы Mid/Side, реверберация и анти-клиппинг" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox x:Name="ChkAudioWasapiMode" IsChecked="True" Content="Низкая задержка WASAPI (15 мс)" VerticalAlignment="Center" Margin="0,0,18,4" Click="ChkAudioWasapiMode_Click"/>
                                <CheckBox x:Name="ChkAudioDrcMode" IsChecked="True" Content="Динамический контроль частоты DRC" VerticalAlignment="Center" Margin="0,0,18,4" Click="ChkAudioDrcMode_Click"/>
                                <CheckBox x:Name="ChkAudioSoftLimiter" IsChecked="True" Content="Мягкий лимитер без треска" VerticalAlignment="Center" Margin="0,0,0,4" Click="ChkAudioSoftLimiter_Click"/>
                            </WrapPanel>

                            <!-- 6 Studio Presets Bar -->
                            <WrapPanel x:Name="PnlAudioDspPresets" Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="Пресеты:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Button x:Name="BtnAudioPresetStudio" Content="Чистый студийный" Style="{StaticResource StormSecondaryButton}" Height="28" Padding="12,0" Margin="0,0,6,4" Tag="Active" Click="BtnAudioPreset_Click"/>
                                <Button x:Name="BtnAudioPresetArcade" Content="Аркадный бас" Style="{StaticResource StormSecondaryButton}" Height="28" Padding="12,0" Margin="0,0,6,4" Click="BtnAudioPreset_Click"/>
                                <Button x:Name="BtnAudioPresetCrt" Content="Тёплый ЭЛТ-динамик" Style="{StaticResource StormSecondaryButton}" Height="28" Padding="12,0" Margin="0,0,6,4" Click="BtnAudioPreset_Click"/>
                                <Button x:Name="BtnAudioPreset3D" Content="Широкая 3D-панорама" Style="{StaticResource StormSecondaryButton}" Height="28" Padding="12,0" Margin="0,0,6,4" Click="BtnAudioPreset_Click"/>
                                <Button x:Name="BtnAudioPresetChiptune" Content="Кристальный чиптюн" Style="{StaticResource StormSecondaryButton}" Height="28" Padding="12,0" Margin="0,0,6,4" Click="BtnAudioPreset_Click"/>
                                <Button x:Name="BtnAudioPresetNight" Content="Ночной компрессор" Style="{StaticResource StormSecondaryButton}" Height="28" Padding="12,0" Margin="0,0,6,4" Click="BtnAudioPreset_Click"/>
                            </WrapPanel>

                            <!-- 4 Sliders UniformGrid -->
                            <UniformGrid Columns="4" Rows="1">
                                <!-- 1. Bass -->
                                <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                            <TextBlock x:Name="TxtAudioBassVal" DockPanel.Dock="Right" Text="0 дБ" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="Усиление баса (НЧ)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderAudioBass" Minimum="-6" Maximum="12" Value="0" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderAudioBass_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Treble -->
                                <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0,3,0">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                            <TextBlock x:Name="TxtAudioTrebleVal" DockPanel.Dock="Right" Text="0 дБ" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="Высокие частоты (ВЧ)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderAudioTreble" Minimum="-6" Maximum="12" Value="0" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderAudioTreble_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Stereo Width -->
                                <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0,3,0">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                            <TextBlock x:Name="TxtAudioStereoVal" DockPanel.Dock="Right" Text="100%" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="Стереопанорама" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderAudioStereo" Minimum="50" Maximum="180" Value="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderAudioStereo_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4. Room Reverb -->
                                <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                            <TextBlock x:Name="TxtAudioReverbVal" DockPanel.Dock="Right" Text="0%" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Text="Акустика комнаты" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderAudioReverb" Minimum="0" Maximum="60" Value="0" SmallChange="2" LargeChange="5" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="SliderAudioReverb_ValueChanged"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Row 2: Settings View Containers (Bento Cards / Ozone / Compact Table) -->
                    <Grid Grid.Row="2">

                        <!-- 1. BENTO CARDS MODE (Default for Settings) -->
                        <ScrollViewer x:Name="SettingsBentoScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="IcSettingsBento">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="560" MinHeight="110" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,12,12">
                                            <DockPanel LastChildFill="True">
                                                <!-- Top Row: Icon + Title + CfgKey Badge -->
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="28" Height="28" CornerRadius="7" Background="{Binding IconBgColor}" BorderBrush="{Binding IconColor}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <Path Data="{Binding IconGeometry}" Fill="{Binding IconColor}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Key Badge -->
                                                    <Border Background="{DynamicResource ThemeBgElevated}" CornerRadius="5" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CfgKey}" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="10.5" FontFamily="Consolas, monospace"/>
                                                    </Border>
                                                </DockPanel>

                                                <!-- Description -->
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Description}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="16"/>

                                                <!-- Control Area: Toggle / ComboBox / Slider / TextBox / Directory -->
                                                <Grid VerticalAlignment="Center">
                                                    <!-- Toggle Switch / CheckBox -->
                                                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" 
                                                              Content="Включено" 
                                                              Visibility="{Binding ToggleVisibility}"/>

                                                    <!-- ComboBox -->
                                                    <ComboBox ItemsSource="{Binding Options}" 
                                                              SelectedItem="{Binding StringValue, Mode=TwoWay}" 
                                                              Height="28" 
                                                              Visibility="{Binding ComboBoxVisibility}"/>

                                                    <!-- Slider -->
                                                    <Grid Visibility="{Binding SliderVisibility}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Slider Minimum="{Binding Min}" 
                                                                Maximum="{Binding Max}" 
                                                                Value="{Binding NumericValue, Mode=TwoWay}" 
                                                                VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding FormattedNumeric}" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- TextBox -->
                                                    <TextBox Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                             Height="28" 
                                                             Visibility="{Binding TextBoxVisibility}"/>

                                                    <!-- Directory Path with Browse Button -->
                                                    <Grid Visibility="{Binding DirectoryVisibility}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding StringValue, Mode=TwoWay}" Height="28"/>
                                                        <Button Grid.Column="1" Content="Обзор..." Style="{StaticResource StormSecondaryButton}" Margin="6,0,0,0" Tag="{Binding}" Click="BtnBrowseSettingDir_Click"/>
                                                    </Grid>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 2. OZONE LIST MODE -->
                        <ScrollViewer x:Name="SettingsOzoneScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="IcSettingsOzone">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="0,0,0,1" Padding="16,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="320"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="238"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding CategoryIcon}" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="16" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding CfgKey}" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="10.5" FontFamily="Consolas, monospace"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                                <!-- Control Area -->
                                                <Grid Grid.Column="3" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" Content="Включено" Visibility="{Binding ToggleVisibility}"/>
                                                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding StringValue, Mode=TwoWay}" Height="28" Visibility="{Binding ComboBoxVisibility}"/>
                                                    <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding NumericValue, Mode=TwoWay}" Visibility="{Binding SliderVisibility}"/>
                                                    <TextBox Text="{Binding StringValue, Mode=TwoWay}" Height="28" Visibility="{Binding TextBoxVisibility}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 3. COMPACT TABLE MODE -->
                        <ListView x:Name="LvSettingsCompact" Visibility="Collapsed" BorderThickness="0" Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Категория" Width="140" DisplayMemberBinding="{Binding CategoryName}"/>
                                    <GridViewColumn Header="Параметр" Width="260" DisplayMemberBinding="{Binding Title}"/>
                                    <GridViewColumn Header="Ключ retroarch.cfg" Width="220">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CfgKey}" Foreground="{DynamicResource ThemeAccentGlow}" FontFamily="Consolas, monospace"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Значение" Width="280">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" Visibility="{Binding ToggleVisibility}"/>
                                                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding StringValue, Mode=TwoWay}" Height="24" Visibility="{Binding ComboBoxVisibility}"/>
                                                    <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding NumericValue, Mode=TwoWay}" Visibility="{Binding SliderVisibility}"/>
                                                    <TextBox Text="{Binding StringValue, Mode=TwoWay}" Height="24" Visibility="{Binding TextBoxVisibility}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- VIEW 3:  ВСЕ ИГРЫ / БИБЛИОТЕКА -->
                <Grid x:Name="ViewLibrary" Visibility="Collapsed" Margin="20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Actions Bar (Row 0) -->
                        <RowDefinition Height="Auto"/> <!-- Smart Collections Pills Bar (Row 1) -->
                        <RowDefinition Height="Auto"/> <!-- Platform Quick-Filter Chips Bar (Row 2) -->
                        <RowDefinition Height="Auto"/> <!-- Alphabetical Quick-Jump Bar (Row 3) -->
                        <RowDefinition Height="Auto"/> <!-- Badges (Row 4) -->
                        <RowDefinition Height="*"/>    <!-- Bento Cards or ListView + Split Inspector (Row 5) -->
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Actions -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="BtnAddFiles" Style="{StaticResource StormAccentButton}" Margin="0,0,8,0" Click="BtnAddFiles_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Добавить файлы" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddFolder" Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Click="BtnAddFolder_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#38BDF8" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Папка с играми" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDownloadBoxarts" Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Click="BtnDownloadBoxarts_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" Fill="#34D399" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Загрузить обложки" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRandomGame" Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Click="BtnRandomGame_Click" ToolTip="Рулетка случайной игры из текущего фильтра">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM7.5 18c-.83 0-1.5-.67-1.5-1.5S6.67 15 7.5 15s1.5.67 1.5 1.5S8.33 18 7.5 18zm0-9C6.67 9 6 8.33 6 7.5S6.67 6 7.5 6 9 6.67 9 7.5 8.33 9 7.5 9zm4.5 4.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4.5 4.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm0-9c-.83 0-1.5-.67-1.5-1.5S15.67 6 16.5 6s1.5.67 1.5 1.5S17.33 9 16.5 9z" Fill="#F59E0B" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Случайная" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnToggleSplitInspector" Style="{StaticResource CapsuleButton}" Tag="Active" Padding="10,4" Margin="0,0,8,0" Click="BtnToggleSplitInspector_Click" ToolTip="Показать или скрыть правую панель инспектора игры">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M3 5v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2zm12 14H5V5h10v14zm4 0h-2V5h2v14z" Fill="#A78BFA" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Инспектор" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnClearList" Style="{StaticResource StormSecondaryButton}" Margin="0,0,12,0" Click="BtnClearList_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Fill="#FB7185" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Очистить" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Platform & Status Dropdown Filters & Sort Selector (Docked Right BEFORE flexible Search Box) -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <ComboBox x:Name="CmbLibrarySort" Width="158" Height="28" Margin="0,0,6,0" SelectionChanged="CmbLibrarySort_SelectionChanged" ToolTip="Сортировка списка игр">
                                <ComboBoxItem Content="По названию (А-Я)" IsSelected="True"/>
                                <ComboBoxItem Content="По платформе"/>
                                <ComboBoxItem Content="По ядру Libretro"/>
                                <ComboBoxItem Content="По размеру файла"/>
                                <ComboBoxItem Content="По времени игры"/>
                                <ComboBoxItem Content="По рейтингу"/>
                                <ComboBoxItem Content="По числу запусков"/>
                            </ComboBox>
                            <ComboBox x:Name="CmbPlatformFilter" Width="152" Height="28" Margin="0,0,6,0" SelectionChanged="CmbPlatformFilter_SelectionChanged"/>
                            <ComboBox x:Name="CmbLibraryCoreFilter" Width="176" Height="28" Margin="0,0,6,0" SelectionChanged="CmbLibraryCoreFilter_SelectionChanged" ToolTip="Фильтр игр по эмуляторному ядру выбранной платформы"/>
                            <ComboBox x:Name="CmbStatusFilter" Width="128" Height="28" SelectionChanged="CmbStatusFilter_SelectionChanged"/>
                        </StackPanel>

                        <!-- Flexible Center Search Box -->
                        <Grid MinWidth="150" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBox x:Name="TxtLibrarySearch" Height="28" Tag="Поиск в библиотеке..." Padding="26,4,8,4" TextChanged="TxtLibrarySearch_TextChanged"/>
                            <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="{DynamicResource ThemeTextMuted}" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>

                    <!-- Row 1: Smart Collections Dynamic Filter Bar -->
                    <Border Grid.Row="1" Margin="0,0,0,8">
                        <WrapPanel x:Name="PnlSmartCollectionPills" Orientation="Horizontal"/>
                    </Border>

                    <!-- Row 2: Platform Quick-Filter Chips Bar -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <StackPanel x:Name="PnlPlatformFilterChips" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <!-- Row 3: Alphabetical Quick-Jump Bar (# / A-Z / А-Я) -->
                    <Border Grid.Row="3" Margin="0,0,0,8">
                        <WrapPanel x:Name="PnlLibraryAlphabetBar" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Row 4: Stat Badges, Platform Default Core Selector & Live Card Scale Slider -->
                    <Border Grid.Row="4" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,2,14,2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Всего игр:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStatTotalGames" Text="0" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="12" FontWeight="Bold" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <TextBlock Text="Готово к запуску:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStatCoresReady" Text="0" Foreground="#10B981" FontSize="12" FontWeight="Bold" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <TextBlock Text="Объём:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStatTotalSize" Text="0 MB" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="Bold" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <Border Width="1" Height="16" Background="{DynamicResource ThemeBorder}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                <!-- Per-Platform Default Core Quick Switcher -->
                                <TextBlock Text="Ядро платформы:" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbPlatformCoreTarget" MinWidth="242" Height="25" Margin="0,0,6,0" SelectionChanged="CmbPlatformCoreTarget_SelectionChanged" ToolTip="Выберите платформу для смены эмуляторного ядра по умолчанию"/>
                                <ComboBox x:Name="CmbPlatformDefaultCore" MinWidth="185" Height="25" Margin="0,0,6,0" DisplayMemberPath="Name" ToolTip="Выберите эмуляторное ядро по умолчанию для выбранной платформы"/>
                                <Button Content="Назначить" Style="{StaticResource CapsuleButton}" Padding="9,3" FontSize="11" FontWeight="SemiBold" Click="BtnApplyPlatformDefaultCore_Click" ToolTip="Назначить выбранное ядро по умолчанию для всех игр этой платформы"/>
                            </StackPanel>

                            <!-- Right: Live Card Zoom Slider + Driver Info -->
                            <StackPanel Margin="0,2,0,2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Размер карточек:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="-" Style="{StaticResource CapsuleButton}" Padding="6,1" FontSize="12" FontWeight="Bold" Margin="0,0,4,0" Click="BtnCardScaleDown_Click" ToolTip="Уменьшить размер карточек игр"/>
                                <Slider x:Name="SliderCardScale" Width="95" Minimum="270" Maximum="540" Value="380" VerticalAlignment="Center" Margin="0,0,4,0" ValueChanged="SliderCardScale_ValueChanged" ToolTip="Плавно изменить размер карточек и обложек"/>
                                <Button Content="+" Style="{StaticResource CapsuleButton}" Padding="6,1" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" Click="BtnCardScaleUp_Click" ToolTip="Увеличить размер карточек игр"/>
                                <TextBlock x:Name="TxtCardScaleReadout" Text="380 px" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="11" FontWeight="SemiBold" Width="42" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <Border Width="1" Height="16" Background="{DynamicResource ThemeBorder}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <TextBlock Text="Драйвер:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStatDriver" Text="VULKAN" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- Row 5: Games Display (Col 0) + Playnite-Style Split Game Inspector (Col 1) -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                        <!-- Mode 1: Scalable & Draggable Bento Cards Mode for Games -->
                        <ItemsControl x:Name="IcGamesBento"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:VirtualizingTilePanel ItemWidth="{Binding DynamicBentoWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 ItemHeight="{Binding DynamicBentoHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding DynamicBentoWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DynamicBentoHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="{DynamicResource ThemeSurface}"
                                                BorderBrush="{DynamicResource ThemeBorder}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12"
                                                Margin="0,0,12,12"
                                                AllowDrop="True"
                                                ContextMenu="{StaticResource GameItemContextMenu}"
                                                MouseLeftButtonDown="GameCard_MouseLeftButtonDown"
                                                PreviewMouseMove="GameCard_PreviewMouseMove"
                                                Drop="GameCard_Drop"
                                                ToolTip="Двойной клик - запуск игры • Правый клик - меню действий • Перетащите карточку для смены места">
                                            <DockPanel LastChildFill="True">
                                                <!-- Left: Scalable High-Res Boxart Cover -->
                                                <Border DockPanel.Dock="Left"
                                                        Width="{Binding DynamicBentoCoverWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Height="{Binding DynamicBentoCoverHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CornerRadius="8"
                                                        ClipToBounds="True"
                                                        Background="#0F172A"
                                                        BorderBrush="{DynamicResource ThemeBorder}"
                                                        BorderThickness="1"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>

                                                <!-- Right: Metadata & Controls -->
                                                <Grid VerticalAlignment="Stretch">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Row 0: Clean Name (Before Year) + Clear Star Favorite Pill Button -->
                                                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
                                                        <Button DockPanel.Dock="Right"
                                                                Background="{Binding FavoriteBgBrush}"
                                                                BorderBrush="{Binding FavoriteBorderBrush}"
                                                                BorderThickness="1"
                                                                Style="{StaticResource StormSecondaryButton}"
                                                                Padding="7,3"
                                                                Margin="6,0,0,0"
                                                                ToolTip="{Binding FavoriteTooltip}"
                                                                Click="BtnToggleFavorite_Click">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{Binding FavoriteIconData}" Fill="{Binding FavoriteStarBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding FavoriteLabel}" Foreground="{Binding FavoriteStarBrush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </DockPanel>

                                                    <!-- Row 1: Platform & Clickable Core Switcher Button -->
                                                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding Platform}" Foreground="#94A3B8" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="135" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <Button Style="{StaticResource CapsuleButton}" Padding="7,2" Click="BtnChangeGameCore_Click" ToolTip="Нажмите, чтобы сменить эмуляторное ядро для этой игры или всей платформы">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5S21.88 11 20.5 11z" Fill="#A78BFA" Stretch="Uniform" Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding CoreDisplayName}" Foreground="#C4B5FD" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                <TextBlock Text=" ▾" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>

                                                    <!-- Row 2: Metadata Badges -->
                                                    <WrapPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,2,0,4">
                                                        <Border Background="#268B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,4"
                                                                Visibility="{Binding HasYear, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Year}" Foreground="#DDD6FE" FontSize="10.5" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="#2638BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,4"
                                                                Visibility="{Binding HasRegion, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Region}" Foreground="#BAE6FD" FontSize="10.5" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,4"
                                                                Visibility="{Binding HasLanguageBadge, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding LanguageBadge}" Foreground="#A7F3D0" FontSize="10.5" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="#26F59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,4"
                                                                Visibility="{Binding HasVersionBadge, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding VersionBadge}" Foreground="#FDE68A" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="#2606B6D4" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,4"
                                                                Visibility="{Binding HasCompletionBadge, Converter={StaticResource BoolToVis}}" ToolTip="Статус прохождения игры">
                                                            <TextBlock Text="{Binding CompletionStatus}" Foreground="#67E8F9" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="#26FBBF24" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,4" ToolTip="Пользовательский рейтинг">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" Fill="#FDE047" Stretch="Uniform" Width="9" Height="9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding StarRatingDisplay}" Foreground="#FDE047" FontSize="10" FontWeight="Bold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#2664748B" BorderBrush="#64748B" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,4" ToolTip="Общее игровое время">
                                                            <TextBlock Text="{Binding PlaytimeText}" Foreground="#CBD5E1" FontSize="10"/>
                                                        </Border>
                                                    </WrapPanel>

                                                    <!-- Row 3: Size & Studio Action Buttons -->
                                                    <DockPanel Grid.Row="3" LastChildFill="True" VerticalAlignment="Bottom">
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding FormattedSize}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource StormSecondaryButton}" Padding="7,3" Margin="0,0,5,0" Click="BtnGameHub_Click" ToolTip="Открыть подробную карточку игры">
                                                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" Fill="#60A5FA" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Style="{StaticResource StormSecondaryButton}" Padding="7,3" Margin="0,0,5,0" Click="BtnGameCheats_Click" ToolTip="Читы и тренеры для этой игры">
                                                                <Path Data="M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13.01 3h1l-1 7h3.51c.4 0 .62.19.4.66C12.97 17.55 11 21 11 21z" Fill="#F59E0B" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Style="{StaticResource StormSecondaryButton}" Padding="7,3" Margin="0,0,5,0" Click="BtnOpenRomFolder_Click" ToolTip="Открыть папку с файлом игры в Проводнике">
                                                                <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#38BDF8" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <Button Style="{StaticResource StormAccentButton}" Padding="11,3" FontSize="12" FontWeight="SemiBold" Click="BtnPlayGame_Click" ToolTip="Запустить игру">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="M8 5v14l11-7z" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Играть" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        <!-- Mode 2: Table / List View for Games -->
                        <ListView x:Name="LvGames"
                                  Visibility="Collapsed"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True"
                                  SelectionMode="Single"
                                  SelectionChanged="LvGames_SelectionChanged"
                                  MouseDoubleClick="LvGames_MouseDoubleClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="ContextMenu" Value="{StaticResource GameItemContextMenu}"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="54">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="Избр." HorizontalAlignment="Center"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="6,4" MinHeight="54" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Button Background="{Binding FavoriteBgBrush}"
                                                            BorderBrush="{Binding FavoriteBorderBrush}"
                                                            BorderThickness="1"
                                                            Style="{StaticResource StormSecondaryButton}"
                                                            Padding="6,4"
                                                            ToolTip="{Binding FavoriteTooltip}"
                                                            Click="BtnToggleFavorite_Click">
                                                        <Path Data="{Binding FavoriteIconData}" Fill="{Binding FavoriteStarBrush}" Stretch="Uniform" Width="13" Height="13"/>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Обложка" Width="72">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="10,4" MinHeight="54" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Border Width="40" Height="50" CornerRadius="4" ClipToBounds="True" Background="#0F172A">
                                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Название игры" Width="240">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="10,4" MinHeight="54" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Год" Width="68">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="8,4" MinHeight="54" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Border Background="#268B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding HasYear, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Year}" Foreground="#DDD6FE" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Регион" Width="74">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="8,4" MinHeight="54" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Border Background="#2638BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding HasRegion, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Region}" Foreground="#BAE6FD" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Язык / Перевод" Width="135">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="8,4" MinHeight="54" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Border Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Visibility="{Binding HasLanguageBadge, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding LanguageBadge}" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Версия" Width="105">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="8,4" MinHeight="54" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <TextBlock Text="{Binding VersionBadge}" Foreground="#FDE68A" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Платформа" Width="165">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="10,4" MinHeight="54" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Ядро эмулятора" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="8,4" MinHeight="54" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Button Style="{StaticResource CapsuleButton}" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Click="BtnChangeGameCore_Click" ToolTip="Нажмите, чтобы сменить ядро для этой игры или всей платформы">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5S21.88 11 20.5 11z" Fill="#A78BFA" Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CoreDisplayName}" Foreground="#C4B5FD" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" ▾" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Размер" Width="85">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="10,4" MinHeight="54" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Действия" Width="155">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,4" MinHeight="54" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Играть" Style="{StaticResource StormAccentButton}" Padding="10,4" Margin="0,0,5,0" Click="BtnPlayGame_Click"/>
                                                        <Button Style="{StaticResource StormSecondaryButton}" Padding="7,4" Margin="0,0,5,0" Click="BtnGameHub_Click" ToolTip="Открыть подробную карточку игры">
                                                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" Fill="#60A5FA" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <Button Style="{StaticResource StormSecondaryButton}" Padding="7,4" Margin="0,0,5,0" Click="BtnGameCheats_Click" ToolTip="Читы и тренеры для этой игры">
                                                            <Path Data="M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13.01 3h1l-1 7h3.51c.4 0 .62.19.4.66C12.97 17.55 11 21 11 21z" Fill="#F59E0B" Stretch="Uniform" Width="12" Height="12"/>
                                                        </Button>
                                                        <Button Style="{StaticResource StormSecondaryButton}" Padding="7,4" Click="BtnOpenRomFolder_Click" ToolTip="Открыть папку с файлом игры">
                                                            <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#38BDF8" Stretch="Uniform" Width="12" Height="12"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Mode 3: Scalable Compact Poster Grid View (Icons Mode) -->
                        <ScrollViewer x:Name="GamesIconsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <ItemsControl x:Name="IcGamesIcons">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding DynamicCompactWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DynamicCompactHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="{DynamicResource ThemeSurface}"
                                                BorderBrush="{DynamicResource ThemeBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10"
                                                Margin="0,0,12,12"
                                                AllowDrop="True"
                                                ContextMenu="{StaticResource GameItemContextMenu}"
                                                MouseLeftButtonDown="GameCard_MouseLeftButtonDown"
                                                PreviewMouseMove="GameCard_PreviewMouseMove"
                                                Drop="GameCard_Drop">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="{Binding DynamicCompactCoverHeightGridLength, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Top: Cover Art + Clear Star Favorite Button -->
                                                <Border Grid.Row="0" CornerRadius="8" ClipToBounds="True" Background="#0F172A" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Button Background="{Binding FavoriteBgBrush}"
                                                                BorderBrush="{Binding FavoriteBorderBrush}"
                                                                BorderThickness="1"
                                                                Style="{StaticResource StormSecondaryButton}"
                                                                Padding="6,4"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"
                                                                ToolTip="{Binding FavoriteTooltip}"
                                                                Click="BtnToggleFavorite_Click">
                                                            <Path Data="{Binding FavoriteIconData}" Fill="{Binding FavoriteStarBrush}" Stretch="Uniform" Width="13" Height="13"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- Title -->
                                                <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="#F8FAFC" FontSize="13.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,4"/>

                                                <!-- Badges Row -->
                                                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                    <Border Background="#268B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,3,2" Visibility="{Binding HasYear, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Year}" Foreground="#DDD6FE" FontSize="9.5" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Background="#2638BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,3,2" Visibility="{Binding HasRegion, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Region}" Foreground="#BAE6FD" FontSize="9.5" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Background="#2610B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,3,2" Visibility="{Binding HasLanguageBadge, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding LanguageBadge}" Foreground="#A7F3D0" FontSize="9.5" FontWeight="Bold"/>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Play & Quick Actions Row -->
                                                <DockPanel Grid.Row="3" LastChildFill="True" VerticalAlignment="Bottom">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource StormSecondaryButton}" Padding="7,4" Margin="4,0,0,0" Click="BtnGameHub_Click" ToolTip="Открыть подробную карточку игры">
                                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" Fill="#60A5FA" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource StormSecondaryButton}" Padding="7,4" Margin="4,0,0,0" Click="BtnGameCheats_Click" ToolTip="Читы и тренеры для этой игры">
                                                        <Path Data="M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13.01 3h1l-1 7h3.51c.4 0 .62.19.4.66C12.97 17.55 11 21 11 21z" Fill="#F59E0B" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource StormSecondaryButton}" Padding="7,4" Margin="4,0,0,0" Click="BtnOpenRomFolder_Click" ToolTip="Открыть папку с файлом игры">
                                                        <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#38BDF8" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                                                    </Button>
                                                    <Button Content="Играть" Style="{StaticResource StormAccentButton}" HorizontalAlignment="Stretch" Padding="0,5" FontSize="12" FontWeight="Bold" Click="BtnPlayGame_Click"/>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State Overlay -->
                        <Border x:Name="EmptyStateBorder" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="16" Background="#208B5CF6" BorderBrush="#608B5CF6" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Path Data="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm3-3c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" Fill="#8B5CF6" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Библиотека игр пуста" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Перетащите файлы игр или архивы прямо сюда мышью или нажмите «Добавить файлы»" Foreground="{DynamicResource ThemeTextMuted}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <Button Style="{StaticResource StormAccentButton}" HorizontalAlignment="Center" Padding="16,8" Click="BtnAddFiles_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Добавить файлы игр" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        </Grid>

                        <!-- Column 1: Playnite-Style Toggleable Right Split Game Inspector -->
                        <Border x:Name="BdrLibrarySplitInspector"
                                Grid.Column="1"
                                Width="330"
                                Margin="12,0,0,0"
                                Visibility="Visible"
                                Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- Cover & Metadata Header -->
                                    <Border Width="148" Height="198" CornerRadius="10" ClipToBounds="True" Background="#0F172A" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <Image x:Name="ImgSplitInspectorCover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <TextBlock x:Name="TxtSplitInspectorTitle" Text="Выберите игру" Foreground="#F8FAFC" FontSize="15.5" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtSplitInspectorPlatform" Text="Нажмите на карточку игры в списке" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>

                                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <Border Background="#2638BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,5,0">
                                            <TextBlock x:Name="TxtSplitInspectorRegion" Text="-" Foreground="#BAE6FD" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                        <Border Background="#268B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock x:Name="TxtSplitInspectorYear" Text="-" Foreground="#DDD6FE" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Primary Action Buttons -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnSplitPlay" Grid.Column="0" Style="{StaticResource StormAccentButton}" Height="34" Margin="0,0,6,0" Click="BtnSplitPlay_Click" ToolTip="Запустить выбранную игру">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M8 5v14l11-7z" Fill="#FFFFFF" Stretch="Uniform" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Играть" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnSplitGameHub" Grid.Column="1" Style="{StaticResource StormSecondaryButton}" Height="34" Padding="10,0" Margin="0,0,6,0" Click="BtnSplitGameHub_Click" ToolTip="Открыть подробную карточку игры">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" Fill="#60A5FA" Stretch="Uniform" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Обзор" FontSize="11.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnSplitFavorite" Grid.Column="2" Style="{StaticResource StormSecondaryButton}" Height="34" Padding="10,0" Click="BtnSplitFavorite_Click" ToolTip="Добавить или убрать из Избранного">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path x:Name="PathSplitFavoriteStar" Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" Fill="#94A3B8" Stretch="Uniform" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtSplitFavoriteLabel" Text="В избр." FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Interactive 5-Star Vector Rating Bar -->
                                    <TextBlock Text="Рейтинг игры:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <UniformGrid Columns="5" Margin="0,0,0,10">
                                        <Button x:Name="BtnSplitStar1" Tag="1" Style="{StaticResource CapsuleButton}" Padding="4,5" Margin="0,0,4,0" HorizontalContentAlignment="Center" Click="BtnSplitStar_Click" ToolTip="Оценка: 1 из 5">
                                            <Path x:Name="PathSplitStar1" Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" Fill="#4B5563" Stretch="Uniform" Width="14" Height="14"/>
                                        </Button>
                                        <Button x:Name="BtnSplitStar2" Tag="2" Style="{StaticResource CapsuleButton}" Padding="4,5" Margin="0,0,4,0" HorizontalContentAlignment="Center" Click="BtnSplitStar_Click" ToolTip="Оценка: 2 из 5">
                                            <Path x:Name="PathSplitStar2" Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" Fill="#4B5563" Stretch="Uniform" Width="14" Height="14"/>
                                        </Button>
                                        <Button x:Name="BtnSplitStar3" Tag="3" Style="{StaticResource CapsuleButton}" Padding="4,5" Margin="0,0,4,0" HorizontalContentAlignment="Center" Click="BtnSplitStar_Click" ToolTip="Оценка: 3 из 5">
                                            <Path x:Name="PathSplitStar3" Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" Fill="#4B5563" Stretch="Uniform" Width="14" Height="14"/>
                                        </Button>
                                        <Button x:Name="BtnSplitStar4" Tag="4" Style="{StaticResource CapsuleButton}" Padding="4,5" Margin="0,0,4,0" HorizontalContentAlignment="Center" Click="BtnSplitStar_Click" ToolTip="Оценка: 4 из 5">
                                            <Path x:Name="PathSplitStar4" Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" Fill="#4B5563" Stretch="Uniform" Width="14" Height="14"/>
                                        </Button>
                                        <Button x:Name="BtnSplitStar5" Tag="5" Style="{StaticResource CapsuleButton}" Padding="4,5" HorizontalContentAlignment="Center" Click="BtnSplitStar_Click" ToolTip="Оценка: 5 из 5">
                                            <Path x:Name="PathSplitStar5" Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" Fill="#4B5563" Stretch="Uniform" Width="14" Height="14"/>
                                        </Button>
                                    </UniformGrid>

                                    <!-- Completion Status -->
                                    <TextBlock Text="Статус прохождения:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbSplitCompletionStatus" Height="28" Margin="0,0,0,10" SelectionChanged="CmbSplitCompletionStatus_SelectionChanged"/>

                                    <!-- Playtime & Launch Telemetry -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="Время игры" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10"/>
                                                <TextBlock x:Name="TxtSplitPlaytime" Text="0 мин" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="5,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Запусков" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10"/>
                                                <TextBlock x:Name="TxtSplitLaunchCount" Text="0" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- External Emulator / Core Quick Selector -->
                                    <TextBlock Text="Движок / Внешний эмулятор:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbSplitExternalEmu" Height="28" Margin="0,0,0,6" SelectionChanged="CmbSplitExternalEmu_SelectionChanged"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnSplitLaunchExternal" Grid.Column="0" Style="{StaticResource StormSecondaryButton}" Height="28" Margin="0,0,4,0" Padding="6,2" Click="BtnSplitLaunchExternal_Click" ToolTip="Запустить через выбранный внешний эмулятор или напрямую">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" Fill="#38BDF8" Stretch="Uniform" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Внешний" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnSplitChangeCore" Grid.Column="1" Style="{StaticResource StormSecondaryButton}" Height="28" Margin="4,0,0,0" Padding="6,2" Click="BtnSplitChangeCore_Click" ToolTip="Выбрать ядро Libretro для этой игры">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7 1.49 0 2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5S21.88 11 20.5 11z" Fill="#A78BFA" Stretch="Uniform" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Ядро" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Personal Game Notes -->
                                    <TextBlock Text="Личные заметки:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSplitNotes" Height="74" HorizontalAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10,8" Margin="0,0,0,8" Tag="Советы, пароли уровней, заметки..." TextChanged="TxtSplitNotes_TextChanged"/>
                                    <Button x:Name="BtnSplitSaveNotes" Style="{StaticResource StormAccentButton}" HorizontalAlignment="Center" MinWidth="220" Height="32" Padding="14,0" Margin="0,0,0,10" Click="BtnSplitSaveNotes_Click" ToolTip="Сохранить заметку и статус прохождения">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" Fill="#FFFFFF" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Сохранить заметку и статус" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Quick Utilities -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnSplitCheats" Grid.Column="0" Style="{StaticResource StormSecondaryButton}" Height="30" Margin="0,0,4,0" Padding="6,2" Click="BtnSplitCheats_Click" ToolTip="Открыть читы и тренеры для этой игры">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13.01 3h1l-1 7h3.51c.4 0 .62.19.4.66C12.97 17.55 11 21 11 21z" Fill="#F59E0B" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Быстрые читы" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnSplitRomHash" Grid.Column="1" Style="{StaticResource StormSecondaryButton}" Height="30" Margin="4,0,0,0" Padding="6,2" Click="BtnSplitRomHash_Click" ToolTip="Вычислить CRC32 / MD5 / SHA-1 файла ROM">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5z" Fill="#34D399" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Хеш ROM" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- VIEW 4:  ИЗБРАННОЕ -->
                <Grid x:Name="ViewFavorites" Visibility="Collapsed" Margin="22,14">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Избранные игры" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Быстрый запуск любимых игр вашей коллекции (отметьте звездой любую игру в разделе «Все игры»)" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource StormSecondaryButton}" Padding="12,6" Click="BtnSyncFavorites_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Fill="#FBBF24" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Обновить список избранного" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <Grid>
                            <ListView x:Name="LvFavorites" BorderThickness="0" Background="Transparent"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      ScrollViewer.CanContentScroll="True"
