                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormAccentButton}" Focusable="False" Padding="10,4" Margin="0,0,8,0" Click="BtnGameQuickMenu_Click" ToolTip="Открыть быстрое меню RetroArch поверх игры (F1)">
