                                        <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,12" Width="{Binding Path=DynamicCardWidth, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Padding="12" Cursor="Hand" MouseLeftButtonDown="GameCard_MouseLeftButtonDown">
