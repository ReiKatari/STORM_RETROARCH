                <!-- VIEW 17:  ДОСТИЖЕНИЯ RETROACHIEVEMENTS (CHEEVOS) -->
                <Grid x:Name="ViewAchievements" Visibility="Collapsed" Margin="22,14">
                    <DockPanel LastChildFill="True">
                        <!-- Top Header: 2 Columns -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Система достижений RetroAchievements" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Авторизация, режим Hardcore, синхронизация с серверами RetroAchievements.org и хеширование CRC32" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StormAccentButton}" Padding="12,6" Margin="0,0,8,0" Click="BtnRefreshAchievements_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Обновить статус" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormSecondaryButton}" Padding="12,6" Click="BtnOpenCheevosProfile_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Fill="#38BDF8" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Профиль RetroAchievements" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                                <!-- 1. Account Credentials Card -->
                                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="#20F59E0B" BorderBrush="#60F59E0B" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Path Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" Fill="#F59E0B" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Учётная запись RetroAchievements.org" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold"/>
                                                    <TextBlock Text="Введите логин и пароль или Web API Token для отслеживания игровых трофеев" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="#1A10B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtCheevosStatusBadge" Text="Подключено к retroarch.cfg" Foreground="#6EE7B7" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DockPanel>

                                        <Grid Margin="0,4,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Имя пользователя (Логин):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TxtCheevosUsername"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Пароль / Web API Key:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TxtCheevosToken"/>
                                            </StackPanel>
                                        </Grid>

                                        <WrapPanel>
                                            <Button Style="{StaticResource StormAccentButton}" Padding="14,6" Margin="0,0,8,0" Click="BtnSaveCheevosAccount_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M17 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Сохранить и привязать к cfg" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource StormSecondaryButton}" Padding="14,6" Click="BtnOpenCheevosProfile_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Fill="#38BDF8" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Открыть профиль на RetroAchievements.org" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. RetroAchievements Core Settings Card (All 7 retroarch.cfg options) -->
                                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Параметры интеграции достижений" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <CheckBox x:Name="ChkCheevosEnable" Content="Включить достижения (cheevos_enable)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosHardcore" Content="Режим Hardcore без стейтов (cheevos_hardcore_mode_enable)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosLeaderboards" Content="Таблицы лидеров (cheevos_leaderboards_enable)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosRichPresence" Content="Rich Presence статус (cheevos_richpresence_enable)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosBadges" Content="Экранные значки трофеев (cheevos_badges_enable)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosAutoScreenshot" Content="Авто-скриншот при получении (cheevos_auto_screenshot)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosTestUnofficial" Content="Тестовые трофеи сообщества (cheevos_test_unofficial)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 3. ROM Library CRC32 & Cheevos Compatibility Check -->
                                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="Проверка контрольных сумм игр вашей библиотеки" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtCheevosLibraryCount" Text="0 игр в библиотеке" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="Для корректного зачёта достижений контрольная сумма CRC32 ROM-файла должна точно совпадать с базой RetroAchievements.org" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5" Margin="0,0,0,10"/>

                                        <ItemsControl x:Name="ItemsCheevosLibrary">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ThemeHeader}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                        <DockPanel LastChildFill="True">
                                                            <Border DockPanel.Dock="Right" Background="{Binding BadgeBg}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SupportStatus}" Foreground="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding GameTitle}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13.5" FontWeight="Bold"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,14,0"/>
                                                                    <TextBlock Text="CRC32: " Foreground="{DynamicResource ThemeTextMuted}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Crc32}" Foreground="#FDE047" FontSize="11" FontFamily="Consolas, monospace" Margin="0,0,14,0"/>
                                                                    <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- VIEW 18:  СТУДИЯ СТРИМИНГА, ЗАПИСИ И AI-ПЕРЕВОДА (STREAM, RECORD & AI SERVICE) -->
                <Grid x:Name="ViewStreamAi" Visibility="Collapsed" Margin="22,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1140" HorizontalAlignment="Left">
                            <TextBlock Text="Студия стриминга, записи видео и AI-перевода" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Прямой эфир на Twitch/YouTube, аппаратный видеозахват через FFmpeg и локальный HTTP AI Service" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" Margin="0,0,0,16"/>

                            <!-- UniformGrid Cards -->
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <!-- Card 1: AI Translation Service -->
                                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text=" Локальный HTTP AI Service" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Фоновый сервер (http://127.0.0.1:4404/) для перехвата запросов автоперевода экрана от RetroArch" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,12"/>
