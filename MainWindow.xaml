                        </ListView>
                    </DockPanel>
                </Grid>

                <!-- VIEW 5: 🕒 ИСТОРИЯ (HISTORY) -->
                <Grid x:Name="ViewHistory" Visibility="Collapsed" Margin="22,14">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="История запусков (History)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Список недавно запущенных игр, синхронизировано с content_history.lpl" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource StormSecondaryButton}" Padding="12,6" Click="BtnClearHistory_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
