                        <ListView x:Name="LvHistory" BorderThickness="0" Background="Transparent" MouseDoubleClick="LvHistory_MouseDoubleClick">
                        </ListView>
                    </DockPanel>
                </Grid>

                <!-- VIEW 6: 🧩 МЕНЕДЖЕР ЯДЕР (CORE DOWNLOADER) -->
                <Grid x:Name="ViewCores" Visibility="Collapsed" Margin="22,14">
                    <DockPanel LastChildFill="True">
                        <!-- Top Header -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Загрузчик ядер Libretro (Core Downloader)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Каталог официальных сборок Libretro Buildbot (350+ ядер) и Золотой набор эмуляторов STORM" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StormAccentButton}" Margin="0,0,8,0" Click="BtnDownloadGoldenCores_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M7 2v11h3v9l7-12h-4l4-8z" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
