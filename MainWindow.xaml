                    </DockPanel>
                </Grid>
<!-- VIEW 17:  ДОСТИЖЕНИЯ RETROACHIEVEMENTS -->
                <Grid x:Name="ViewAchievements" Visibility="Collapsed" Margin="22,14">
                    <DockPanel LastChildFill="True">
                        <!-- Top Header: 2 Columns -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14">
