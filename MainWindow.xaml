                                                    </DockPanel>
                                                    <Slider x:Name="SliderShaderVignette" Minimum="0" Maximum="60" Value="18" ValueChanged="SliderShaderVignette_ValueChanged"/>
                                                </StackPanel>
                                            </Border>

