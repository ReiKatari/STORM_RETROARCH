                                                <Path Data="M11 18V6l-8.5 6 8.5 6zm.5-6l8.5 6V6l-8.5 6z" Fill="#38BDF8" Stretch="Uniform" Width="9" Height="9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Перемотка" FontSize="10.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <ProgressBar x:Name="PbRewindBuffer" Width="36" Height="6" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" Margin="0,0,3,0" ToolTip="Заполнение буфера перемотки"/>
                                        <Button x:Name="BtnGameFastForward" Style="{StaticResource StormSecondaryButton}" Focusable="False" Padding="6,2" Margin="0,0,3,0" Click="BtnGameFastForward_Click" ToolTip="Ускоренная перемотка (Space / Пробел)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M4 18l8.5-6L4 6v12zm9-12v12l8.5-6L13 6z" Fill="#F59E0B" Stretch="Uniform" Width="9" Height="9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtGameFastForwardLabel" Text="Турбо" FontSize="10.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource StormSecondaryButton}" Focusable="False" Padding="6,2" Click="BtnGameStop_Click" ToolTip="Остановить эмуляцию и выгрузить ядро">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M6 6h12v12H6z" Fill="#EF4444" Stretch="Uniform" Width="9" Height="9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Стоп" FontSize="10.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- CAPSULE 3: СТЕЙТЫ (CmbInGameStateSlot, Сохр. F2, Загр. F4) -->
                                <Border Background="#14FFFFFF" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="4,2" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="CmbInGameStateSlot" Focusable="False" MinWidth="58" Height="24" FontSize="10" Margin="0,0,3,0" VerticalContentAlignment="Center" SelectionChanged="CmbInGameStateSlot_SelectionChanged" ToolTip="Выбор слота сохранения (0-99)">
                                            <ComboBoxItem Content="Слот 0" IsSelected="True"/>
                                            <ComboBoxItem Content="Слот 1"/>
                                            <ComboBoxItem Content="Слот 2"/>
                                            <ComboBoxItem Content="Слот 3"/>
                                            <ComboBoxItem Content="Слот 4"/>
                                            <ComboBoxItem Content="Слот 5"/>
                                            <ComboBoxItem Content="Слот 6"/>
                                            <ComboBoxItem Content="Слот 7"/>
                                            <ComboBoxItem Content="Слот 8"/>
                                            <ComboBoxItem Content="Слот 9"/>
