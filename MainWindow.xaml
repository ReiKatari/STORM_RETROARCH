            <!-- ==================== INTERACTIVE SIDEBAR GRIDSPLITTER ==================== -->
            <GridSplitter x:Name="SidebarSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="False"
                          DragCompleted="SidebarSplitter_DragCompleted"
                          ToolTip="Перетащите влево или вправо для изменения ширины бокового меню">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="#01000000">
                            <Border x:Name="SplitLine" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ThemeBorderSubtle}"/>
                            <Border x:Name="SplitHandle" Width="4" Height="42" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ThemeBorder}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitLine" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="SplitHandle" Property="Background" Value="{DynamicResource ThemeAccentGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ==================== RIGHT CONTENT WORKSPACE ==================== -->
