                                        <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,12" Width="{Binding Path=DynamicCardWidth, RelativeSource={RelativeSource AncestorType=Window}}" Padding="14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="14" FontFamily="Consolas, monospace"/>
                                                    <Border HorizontalAlignment="Right" Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="Подпапка: " Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5"/>
                                                        <TextBlock Text="{Binding SubfolderDisplay}" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" FontFamily="Consolas, monospace" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="MD5 эталон: " Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5"/>
                                                        <TextBlock Text="{Binding ExpectedMd5}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10.5" FontFamily="Consolas, monospace"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <DockPanel Grid.Row="3" LastChildFill="True">
                                                    <Border HorizontalAlignment="Left" Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Button Style="{StaticResource StormSecondaryButton}" HorizontalAlignment="Right" Padding="10,4" Tag="{Binding}" Click="BtnImportSingleBios_Click">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Fill="#38BDF8" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Импорт" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- VIEW 13:  ЧИТЫ И ТРЕНЕРЫ -->
                <Grid x:Name="ViewCheats" Visibility="Collapsed" Margin="22,14">
                    <DockPanel LastChildFill="True">
                        <!-- Header & Action Bar -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,9">
                                    <TextBlock Text="Читы и тренеры игр" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Полная база Libretro (26 800+ игр на 65+ платформах), 100% поддержка игр вашей библиотеки и живой сканер ОЗУ" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StormAccentButton}" Margin="0,0,8,0" Click="BtnDownloadCheatsDb_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Загрузить базу Libretro" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Click="BtnCreateCheatFile_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#38BDF8" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Новый чит-файл" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Click="BtnOpenCheatsDir_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#FBBF24" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Папка чит-кодов" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormSecondaryButton}" Click="BtnRefreshCheats_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Fill="#34D399" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Обновить" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>

                                <!-- 2.0.0 Живой сканер оперативной памяти ОЗУ -->
        <Border x:Name="BdrLiveRamScanner" DockPanel.Dock="Top" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <!-- Header & Controls -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="7" Background="#208B5CF6" BorderBrush="#608B5CF6" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="M15 3H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v7c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-7c0-.26-.05-.5-.14-.73l-3.02-7.05C17.54 3.5 16.83 3 16 3zm-9 2h9l2.57 6H3.43L6 5zm13 14H3v-6h16v6z" Fill="#A78BFA" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Живой сканер оперативной памяти ОЗУ (Поиск, изменение и заморозка значений)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtRamScanSummary" Text="Готов к сканированию ОЗУ" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Filter Controls WrapPanel -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Разрядность:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbRamWidth" MinWidth="148" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                            <ComboBoxItem Content="8 бит (0-255)"/>
                            <ComboBoxItem Content="16 бит (0-65535)" IsSelected="True"/>
                            <ComboBoxItem Content="32 бит (0-4294967295)"/>
                        </ComboBox>

                        <TextBlock Text="Сравнение:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbRamCompare" MinWidth="170" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                            <ComboBoxItem Content="Точное (=)" IsSelected="True"/>
                            <ComboBoxItem Content="Не равно (!=)"/>
                            <ComboBoxItem Content="Увеличилось (&gt;)"/>
                            <ComboBoxItem Content="Уменьшилось (&lt;)"/>
                            <ComboBoxItem Content="Изменилось"/>
                            <ComboBoxItem Content="Не изменилось"/>
                        </ComboBox>

                        <TextBlock Text="Значение:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtRamTargetValue" Width="96" Height="28" Text="100" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Искомое значение в памяти"/>

                        <Button x:Name="BtnRamFirstScan" Style="{StaticResource StormAccentButton}" Height="28" Padding="12,0" Margin="0,0,6,0" Click="BtnRamFirstScan_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="#FFFFFF" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Первый поиск" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnRamNextScan" Style="{StaticResource StormSecondaryButton}" Height="28" Padding="12,0" Margin="0,0,6,0" Click="BtnRamNextScan_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z" Fill="#38BDF8" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Отсеять" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnRamResetScan" Style="{StaticResource StormSecondaryButton}" Height="28" Padding="12,0" Margin="0,0,12,0" Click="BtnRamResetScan_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Fill="#FB7185" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Сброс" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="18" Background="{DynamicResource ThemeBorder}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <TextBlock Text="Новое знач.:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtRamPokeValue" Width="86" Height="28" Text="999" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Значение для быстрой записи или заморозки"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Scrollable compact results list -->
                <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="6">
                    <ScrollViewer MaxHeight="135" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsRamMatches">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                        <DockPanel LastChildFill="True">
                                            <!-- Action Buttons Docked Right -->
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource StormSecondaryButton}" Height="24" Padding="10,0" Margin="0,0,5,0" Tag="{Binding}" Click="BtnRamPokeEntry_Click" ToolTip="Записать новое значение в ячейку памяти">
                                                    <TextBlock Text="Записать" FontSize="11" VerticalAlignment="Center"/>
                                                </Button>
                                                <Button Style="{StaticResource StormSecondaryButton}" Height="24" Padding="10,0" Margin="0,0,5,0" Tag="{Binding}" Click="BtnRamFreezeEntry_Click" ToolTip="Заморозить значение ячейки памяти">
                                                    <TextBlock Text="Заморозить" FontSize="11" VerticalAlignment="Center"/>
                                                </Button>
                                                <Button Style="{StaticResource StormAccentButton}" Height="24" Padding="10,0" Tag="{Binding}" Click="BtnRamExportEntry_Click" ToolTip="Экспортировать адрес в чит-код .cht">
                                                    <TextBlock Text="В чит .cht" FontSize="11" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Left Address and Values -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#258B5CF6" BorderBrush="#708B5CF6" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding HexAddress}" Foreground="#A78BFA" FontSize="11.5" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                                                </Border>
                                                <TextBlock Text="{Binding FormattedValues}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas, monospace" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DescriptionRu}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>

                        <!-- 2 Columns: Files List & Cheat Details -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="410"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Cheat Files List -->
                            <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,14,0">
                                <DockPanel LastChildFill="True">
                                    <TextBox x:Name="TxtSearchCheats" DockPanel.Dock="Top" Tag="Поиск игры или платформы..." Margin="0,0,0,8" TextChanged="TxtSearchCheats_TextChanged"/>
                                    <ComboBox x:Name="CmbCheatsPlatformFilter" DockPanel.Dock="Top" Height="28" Margin="0,0,0,8" SelectionChanged="CmbCheatsPlatformFilter_SelectionChanged" ToolTip="Фильтр чит-файлов по игровой платформе"/>
                                    <!-- Filter Toggle: All DB vs Library (Zero Clipping 2-Column Grid) -->
                                    <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,10">
                                        <Button x:Name="BtnCheatsFilterAll" Content="Все читы" Style="{StaticResource CategoryChipButton}" Tag="Active" Padding="8,5" FontSize="11.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" Click="BtnCheatsFilter_Click"/>
                                        <Button x:Name="BtnCheatsFilterLibrary" Content="Библиотека" Style="{StaticResource CategoryChipButton}" Padding="8,5" FontSize="11.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0" Click="BtnCheatsFilter_Click"/>
                                    </UniformGrid>
                                    <ListBox x:Name="ListCheatFiles" Background="Transparent" BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="ListCheatFiles_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="10,8"/>
                                                <Setter Property="Margin" Value="0,0,0,4"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,8" HorizontalAlignment="Stretch">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding GameName}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <Border Margin="6,0,0,0" Background="#166534" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLibraryGame}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="В БИБЛИОТЕКЕ" Foreground="#86EFAC" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="6,2" Background="{DynamicResource ThemeSurfaceLight}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1">
                                                            <TextBlock Text="{Binding CheatCountBadge}" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Right: Cheat Editor Panel -->
                            <Border Grid.Column="1" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <DockPanel LastChildFill="True">
                                    <!-- Header & Actions -->
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock x:Name="TxtSelectedCheatGame" Text="Выберите игру из списка слева" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TxtSelectedCheatPath" Text="Формат RetroArch .cht" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Включить все" Style="{StaticResource StormSecondaryButton}" Margin="0,0,6,0" Padding="10,5" Click="BtnEnableAllCheats_Click"/>
                                            <Button Content="Отключить все" Style="{StaticResource StormSecondaryButton}" Margin="0,0,6,0" Padding="10,5" Click="BtnDisableAllCheats_Click"/>
                                            <Button x:Name="BtnAddCheatRow" Content="Добавить чит" Style="{StaticResource StormSecondaryButton}" Margin="0,0,6,0" Padding="10,5" Click="BtnAddCheatRow_Click"/>
                                            <Button x:Name="BtnSaveCheats" Content="Применить и сохранить" Style="{StaticResource StormAccentButton}" Padding="12,5" Click="BtnSaveCheats_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ItemsCheatEntries">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="238"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                                <TextBlock Text="Описание чита" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" Margin="0,0,0,3"/>
                                                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                                <TextBlock Text="Чит-код (адрес памяти или код)" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" Margin="0,0,0,3"/>
                                                                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, monospace"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="3" Content="" Style="{StaticResource WindowCaptionButton}" VerticalAlignment="Bottom" Margin="0,0,0,2" Tag="{Binding}" Click="BtnDeleteCheatRow_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- VIEW 14:  РАМКИ BEZEL И ЭКРАН (BEZELS & OVERLAYS) -->
                <Grid x:Name="ViewBezels" Visibility="Collapsed" Margin="22,14" AllowDrop="True" Drop="ViewBezels_Drop" DragOver="Window_PreviewDragOver">
                    <DockPanel LastChildFill="True">
                        <!-- Header & Action Bar -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,9">
                                    <TextBlock Text="Экранные рамки и оверлеи" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Онлайн-пакеты HSM Mega Bezel и Duimon Mega Bezel, шейдерные отражения ЭЛТ и полная поддержка рамок для всех 360 ядер" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StormAccentButton}" Margin="0,0,8,0" Click="BtnToggleManualBezelPanel_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Добавить рамку вручную" VerticalAlignment="Center" FontWeight="SemiBold"/>
