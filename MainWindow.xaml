                                                    <TextBlock Text="Открыть профиль на RetroAchievements.org" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 2. RetroAchievements Core Settings Card (All 7 retroarch.cfg options) -->
                                <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Параметры интеграции достижений" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <CheckBox x:Name="ChkCheevosEnable" Content="Включить достижения (cheevos_enable)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosHardcore" Content="Режим Hardcore без стейтов (cheevos_hardcore_mode_enable)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosLeaderboards" Content="Таблицы лидеров (cheevos_leaderboards_enable)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosRichPresence" Content="Rich Presence статус (cheevos_richpresence_enable)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosBadges" Content="Экранные значки трофеев (cheevos_badges_enable)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosAutoScreenshot" Content="Авто-скриншот при получении (cheevos_auto_screenshot)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                            <CheckBox x:Name="ChkCheevosTestUnofficial" Content="Тестовые трофеи сообщества (cheevos_test_unofficial)" VerticalAlignment="Center" Margin="0,0,18,10" Click="ChkCheevosOption_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

