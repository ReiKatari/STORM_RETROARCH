                                                    </DockPanel>
                                                    <Slider x:Name="SliderShaderChromatic" Minimum="0" Maximum="100" Value="0" ValueChanged="SliderShaderChromatic_ValueChanged"/>
                                                </StackPanel>
                                            </Border>

