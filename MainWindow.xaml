                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StormSecondaryButton}" Focusable="False" Padding="8,3" Margin="0,0,4,0" Click="BtnExitGame_Click" ToolTip="Вернуться в главное меню">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" Fill="#FB7185" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="← К играм" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormAccentButton}" Focusable="False" Padding="9,3" Margin="0,0,6,0" Click="BtnGameQuickMenu_Click" ToolTip="Открыть быстрое меню RetroArch (F1)">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" Fill="#FFFFFF" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Меню (F1)" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Width="1" Height="16" Background="{DynamicResource ThemeBorder}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtActiveGameTitle" Text="STORM RETROARCH" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    <Border x:Name="BadgeActivePlatform" Background="#1A8B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtActiveGamePlatform" Text="Libretro" Foreground="#C4B5FD" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border x:Name="BadgeActiveCore" Background="#1A38BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtActiveGameCore" Text="Ready" Foreground="#7DD3FC" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border x:Name="BdrHudActiveDeviceBadge" Background="#1A10B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="0,0,2,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtHudActiveDeviceBadge" Text="Xbox Wireless" Foreground="#34D399" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                    <Button x:Name="BtnHudCycleGpuBackend" Style="{StaticResource StormSecondaryButton}" Padding="6,1" Margin="4,0,0,0" VerticalAlignment="Center" Click="BtnHudCycleGpuBackend_Click" ToolTip="Графический движок: Авто / Vulkan / Direct3D 12 / Direct3D 11 / OpenGL Core / AVX2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M15 9H9v6h6V9zm-2 4h-2v-2h2v2zm8-2V9h-2V7c0-1.1-.9-2-2-2h-2V3h-2v2h-2V3H9v2H7c-1.1 0-2 .9-2 2v2H3v2h2v2H3v2h2v2c0 1.1.9 2 2 2h2v2h2v-2h2v2h2v-2h2c1.1 0 2-.9 2-2v-2h2v-2h-2v-2h2zm-4 6H7V7h10v10z" Fill="#38BDF8" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtHudGpuBackendBadge" Text="GPU: Авто" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- CENTER / RIGHT: 4 Sleek Tactile Capsules in a WrapPanel -->
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- CAPSULE 2: ХОД ИГРЫ (Пауза, Кадр, Перемотка, Турбо, Стоп) -->
                                <Border Background="#14FFFFFF" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="4,2" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnGamePause" Style="{StaticResource StormSecondaryButton}" Focusable="False" Padding="6,2" Margin="0,0,3,0" Click="BtnGamePause_Click" ToolTip="Пауза / Возобновить игру (P)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path x:Name="IconGamePause" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" Fill="{DynamicResource ThemeTextPrimary}" Stretch="Uniform" Width="9" Height="9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtGamePauseLabel" Text="Пауза" FontSize="10.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnGameFrameAdvance" Style="{StaticResource StormSecondaryButton}" Focusable="False" Padding="6,2" Margin="0,0,3,0" Click="BtnGameFrameAdvance_Click" ToolTip="Покадровое продвижение (K)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Fill="{DynamicResource ThemeTextPrimary}" Stretch="Uniform" Width="9" Height="9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Кадр" FontSize="10.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource StormSecondaryButton}" Focusable="False" Padding="6,2" Margin="0,0,3,0" Click="BtnGameRewind_Click" ToolTip="Перемотка назад (R)">
