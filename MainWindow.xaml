                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnToggleTelemetry" Style="{StaticResource StormSecondaryButton}" Padding="10,5" Margin="0,0,14,0" Click="BtnToggleTelemetry_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" Fill="#FBBF24" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Телеметрия" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Active View Instant Search Box -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ThemeHeader}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Width="260" Height="30" Padding="8,0">
                        <Grid>
                            <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimary}" TextChanged="TxtSearch_TextChanged"/>
                            <StackPanel x:Name="TxtSearchPlaceholder" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="{DynamicResource ThemeTextMuted}" Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Поиск (игры, параметры, ядра)..." Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
                <!-- ==================== LIVE TELEMETRY & INPUT LATENCY HUD ==================== -->
                <Border x:Name="PnlTelemetryOverlay" Visibility="Collapsed" Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="14,8">
                    <DockPanel LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border Background="#1A10B981" BorderBrush="#8010B981" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " FontSize="12" Foreground="#10B981" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTelemFps" Text="60.0 FPS • 16.7 ms" Foreground="#10B981" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1A8B5CF6" BorderBrush="#808B5CF6" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯 " FontSize="12" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTelemLatency" Text="Задержка: 4.2 мс (Ультра-низкая)" Foreground="#A78BFA" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1A3B82F6" BorderBrush="#803B82F6" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💻 " FontSize="12" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTelemCpuRam" Text="ЦП: 2.4% • ОЗУ: 145 МБ" Foreground="#60A5FA" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1AF59E0B" BorderBrush="#80F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎮 " FontSize="12" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTelemDriver" Text="Драйвер: VULKAN • Run-Ahead 1к" Foreground="#FBBF24" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="🖥️ Внутриигровой OSD RetroArch" Style="{StaticResource StormSecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,8,0" Click="BtnToggleNativeOsd_Click"/>
                            <Button Content="✕ Скрыть" Style="{StaticResource StormSecondaryButton}" Padding="10,4" FontSize="11" Click="BtnCloseTelemetry_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ==================== ROW 2: MAIN WORKSPACE (SIDEBAR + 9 VIEWS) ==================== -->
