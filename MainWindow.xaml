                                                    <ComboBoxItem Content="D65 (Стандарт 6500K)" IsSelected="True"/>
                                                    <ComboBoxItem Content="D50 (Тёплый CRT 5000K)"/>
                                                    <ComboBoxItem Content="D93 (Японский аркадный 9300K)"/>
