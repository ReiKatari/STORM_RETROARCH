                                <TextBlock Text="Библиотека игр пуста" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Перетащите файлы игр или архивы прямо сюда (Drag-and-Drop) или нажмите «Добавить файлы»" Foreground="{DynamicResource ThemeTextMuted}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <Button Style="{StaticResource StormAccentButton}" HorizontalAlignment="Center" Padding="16,8" Click="BtnAddFiles_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Добавить файлы игр" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- VIEW 4: ⭐ ИЗБРАННОЕ (FAVORITES) -->
                <Grid x:Name="ViewFavorites" Visibility="Collapsed" Margin="22,14">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Избранные игры (Favorites)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Быстрый запуск лучших игр серии, синхронизировано с content_favorites.lpl" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
