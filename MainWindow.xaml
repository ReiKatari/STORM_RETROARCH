                                    <TextBlock Text="История" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- GROUP 2: ДВИЖОК И ЯДРА -->
                            <TextBlock Text="ДВИЖОК И ЯДРА" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10" FontWeight="Bold" Margin="10,14,0,4"/>

                            <Button x:Name="NavBtnCores" Style="{StaticResource SidebarNavButton}" Click="NavBtn_Click">
