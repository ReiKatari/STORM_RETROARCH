                    <TextBlock Text="Полнофункциональная улучшенная реплика RetroArch с интеграцией Libretro ядер, поддержкой минимальной задержки ввода, адаптивной частоты кадров и чистого звука, встроенным онлайн-обновлением, менеджером сейвов и 100% тёмной стилизацией всех элементов управления."
                               Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,14"/>

                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="STORM-AURORA-FLUID-CERT-2026-RETROARCH-ORIGINAL-AUTHENTIC-BUILD-VERIFIED" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Text="Разработчик: STORM TEAM | 2026" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Закрыть" Style="{StaticResource StormAccentButton}" Width="100" HorizontalAlignment="Right" Click="BtnCloseAbout_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. OVERLAY: PER-GAME & PER-PLATFORM CORE SELECTOR MODAL -->
        <Grid x:Name="PnlCoreSelectorModal" Visibility="Collapsed" Background="#D805050C" Grid.Row="0" Grid.RowSpan="10" Grid.Column="0" Grid.ColumnSpan="10" Panel.ZIndex="9998" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="14" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.85"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource CapsuleButton}" Padding="8,3" Click="BtnCloseCoreSelectorModal_Click"/>
                        <StackPanel>
                            <TextBlock x:Name="TxtCoreModalTitle" Text="Выбор эмуляторного ядра" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="17" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtCoreModalSubtitle" Text="Платформа: Nintendo Entertainment System" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Выберите совместимое ядро эмулятора для запуска этой игры:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,8"/>

                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="6" MaxHeight="260" Margin="0,0,0,12">
                        <ListBox x:Name="LstModalCompatibleCores" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,5">
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Background="#2010B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="Доступно" Foreground="#6EE7B7" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13.5" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <CheckBox x:Name="ChkSetCoreDefaultForPlatform" Content="Сделать выбранное ядро стандартным по умолчанию для всех игр этой платформы" IsChecked="True" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Style="{StaticResource StormSecondaryButton}" Width="100" Margin="0,0,10,0" Click="BtnCloseCoreSelectorModal_Click"/>
                        <Button Content="✔ Применить выбранное ядро" Style="{StaticResource StormAccentButton}" Padding="16,6" FontWeight="Bold" Click="BtnConfirmCoreSelectorModal_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
    </Border>
</Window>
