                                            <Path Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" Fill="#FFFFFF" Stretch="Uniform" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Меню (F1)" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Width="1" Height="18" Background="{DynamicResource ThemeBorder}" Margin="0,0,8,0"/>
