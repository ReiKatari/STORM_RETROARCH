                                            </DockPanel>

                                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                <Slider x:Name="SliderShaderSplitCompare" Minimum="0" Maximum="100" Value="50" ValueChanged="SliderShaderSplitCompare_ValueChanged"/>
                                                <DockPanel Margin="0,2,0,0">
                                                    <TextBlock Text="◄ Исходный пиксель" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10"/>
                                                    <TextBlock Text="ЭЛТ-фильтр ►" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="10"/>
                                                </DockPanel>
                                            </StackPanel>

                                            <!-- CRT Monitor Screen Surface -->
                                            <Border CornerRadius="6" ClipToBounds="True" Background="#000000" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1">
                                                <Image x:Name="ImgShaderLivePreview" Height="186" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
