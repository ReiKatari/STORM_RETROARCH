                                            <Border Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,6">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                                        <TextBlock x:Name="TxtShaderMaskVal" Text="25%" DockPanel.Dock="Right" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
                                                        <TextBlock Text="Апертурная маска" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </DockPanel>
                                                    <Slider x:Name="SliderShaderMask" Minimum="0" Maximum="75" Value="25" ValueChanged="SliderShaderMask_ValueChanged"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 3. Curvature (0..50) -->
                                            <Border Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                                        <TextBlock x:Name="TxtShaderCurvatureVal" Text="0%" DockPanel.Dock="Right" Foreground="#A78BFA" FontSize="12" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
                                                        <TextBlock Text="Кривизна кинескопа" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </DockPanel>
                                                    <Slider x:Name="SliderShaderCurvature" Minimum="0" Maximum="50" Value="0" ValueChanged="SliderShaderCurvature_ValueChanged"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 4. Chromatic RGB (0..100) -->
                                            <Border Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                                        <TextBlock x:Name="TxtShaderChromaticVal" Text="0%" DockPanel.Dock="Right" Foreground="#EC4899" FontSize="12" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
