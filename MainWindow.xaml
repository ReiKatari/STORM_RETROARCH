<Window x:Class="StormRetroArch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StormRetroArch"
        Title="STORM RETROARCH 1.0.0"
        Width="1480" Height="860"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource ThemeBgWindow}"
        FontFamily="{DynamicResource AppFontFamily}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown"
        AllowDrop="True">

    <Window.Resources>
        <!-- Dark ScrollBar Style with >=16px margin and theme colors -->
        <Style x:Key="StormScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{DynamicResource ThemeBorderSubtle}" CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource StormScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3D Volumetric Tactile Accent Button Style -->
        <Style x:Key="StormAccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Elevated Button Style -->
        <Style x:Key="StormSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Button Style -->
        <Style x:Key="WindowCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E11D48"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListViewItem Style -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GridViewColumnHeader Style -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeBgHeader}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" AllowDrop="True" Drop="RootGrid_Drop" DragOver="RootGrid_DragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/> <!-- Row 0: Custom TitleBar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Hero Section & Subtitle -->
            <RowDefinition Height="*"/> <!-- Row 2: Main Workspace -->
            <RowDefinition Height="Auto"/> <!-- Row 3: Footer -->
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: CUSTOM TITLEBAR ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- App Icon & Title -->
                    <ColumnDefinition Width="*"/>    <!-- Center Spacing / Drag Area -->
                    <ColumnDefinition Width="Auto"/> <!-- Selectors & Top Buttons -->
                    <ColumnDefinition Width="Auto"/> <!-- Window Caption Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Left: App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="app_icon.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="STORM RETROARCH 1.0.0" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Selectors & Header Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Language Selector -->
                    <TextBlock x:Name="LblLang" Text="Язык:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbLanguage" Width="105" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="CmbLanguage_SelectionChanged"/>

                    <!-- Theme Selector -->
                    <TextBlock x:Name="LblTheme" Text="Тема:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbTheme" Width="110" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="CmbTheme_SelectionChanged"/>

                    <!-- Accent Selector -->
                    <TextBlock x:Name="LblAccent" Text="Цвет:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbAccent" Width="95" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" SelectionChanged="CmbAccent_SelectionChanged"/>

                    <!-- Font Selector -->
                    <TextBlock x:Name="LblFont" Text="Шрифт:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbFont" Width="120" Height="26" Margin="0,0,14,0" VerticalAlignment="Center" SelectionChanged="CmbFont_SelectionChanged"/>

                    <!-- Header Action Buttons -->
                    <Button x:Name="BtnCheckUpdates" Style="{StaticResource StormSecondaryButton}" Content="Обновления" Margin="0,0,6,0" Click="BtnCheckUpdates_Click"/>
                    <Button x:Name="BtnCoresManager" Style="{StaticResource StormSecondaryButton}" Content="Ядра Libretro" Margin="0,0,6,0" Click="BtnCoresManager_Click"/>
                    <Button x:Name="BtnEngineSettings" Style="{StaticResource StormSecondaryButton}" Content="Движок" Margin="0,0,6,0" Click="BtnEngineSettings_Click"/>
                    <Button x:Name="BtnAbout" Style="{StaticResource StormSecondaryButton}" Content="О программе" Margin="0,0,6,0" Click="BtnAbout_Click"/>
                </StackPanel>

                <!-- Far Right: Caption Buttons (Min, Max, Close) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMin" Style="{StaticResource WindowCaptionButton}" Click="BtnMin_Click">
                        <Path Data="M 0,5 L 10,5" Stroke="{DynamicResource ThemeTextPrimary}" StrokeThickness="1.5"/>
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource WindowCaptionButton}" Click="BtnMax_Click">
                        <Path x:Name="PathMax" Data="M 0,0 L 9,0 L 9,9 L 0,9 Z" Stroke="{DynamicResource ThemeTextPrimary}" StrokeThickness="1.2"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource ThemeTextPrimary}" StrokeThickness="1.5"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 1: HERO SECTION ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeBgHeader}" Padding="24,14,24,14" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="22" >
                        <Run Text="STORM" Foreground="{DynamicResource ThemeAccent}" FontWeight="Black"/><Run Text=" RETROARCH" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Black"/>
                    </TextBlock>
                    <TextBlock x:Name="TxtSubtitle" Text="Универсальный ультра-быстрый эмулятор и фронтенд Libretro с авто-докачкой ядер, нулевой задержкой ввода и поддержкой 30+ платформ" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Fullscreen Ozone Button in Hero Section -->
                <Button Grid.Column="1" x:Name="BtnFullscreenOzone" Style="{StaticResource StormAccentButton}" Height="38" Padding="18,0" VerticalAlignment="Center" Click="BtnFullscreenOzone_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎮 ПОЛНОЭКРАННЫЙ РЕЖИМ OZONE" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ==================== ROW 2: MAIN WORKSPACE ==================== -->
        <Grid Grid.Row="2" Margin="24,16,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Toolbar Tier 1 -->
                <RowDefinition Height="Auto"/> <!-- Badges Tier 2 -->
                <RowDefinition Height="*"/>    <!-- Games Library Table / Empty View -->
            </Grid.RowDefinitions>

            <!-- Toolbar Tier 1: Action Buttons & Filters -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Add Games, Add Folder, Clear -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnAddFiles" Style="{StaticResource StormAccentButton}" Height="36" Padding="16,0" Margin="0,0,8,0" Click="BtnAddFiles_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 6,0 L 6,12 M 0,6 L 12,6" Stroke="White" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Добавить игры..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAddFolder" Style="{StaticResource StormSecondaryButton}" Height="36" Padding="14,0" Margin="0,0,8,0" Click="BtnAddFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0,2 L 5,2 L 7,4 L 14,4 L 14,12 L 0,12 Z" Stroke="{DynamicResource ThemeTextPrimary}" StrokeThickness="1.2" Fill="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Добавить папку..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnClearList" Style="{StaticResource StormSecondaryButton}" Height="36" Padding="12,0" Margin="0,0,12,0" Click="BtnClearList_Click">
                        <TextBlock Text="Очистить список" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Auto-check on startup checkbox -->
                    <CheckBox x:Name="ChkCheckUpdatesStartup" Content="Проверять обновления при запуске" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Checked="ChkCheckUpdatesStartup_Changed" Unchecked="ChkCheckUpdatesStartup_Changed"/>
                </StackPanel>

                <!-- Right: Search & Dropdown Filters -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Search Box -->
                    <Border Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Height="36" Width="260" Margin="0,0,10,0" Padding="8,0">
                        <Grid VerticalAlignment="Center">
                            <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock x:Name="TxtSearchPlaceholder" Text="Поиск по названию или платформе..." Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Platform Filter -->
                    <ComboBox x:Name="CmbPlatformFilter" Width="170" Height="36" Margin="0,0,8,0" VerticalAlignment="Center" SelectionChanged="CmbPlatformFilter_SelectionChanged"/>

                    <!-- Status Filter -->
                    <ComboBox x:Name="CmbStatusFilter" Width="150" Height="36" VerticalAlignment="Center" SelectionChanged="CmbStatusFilter_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <!-- Badges Tier 2: Statistics & Engine Status -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Games -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0">
                        <TextBlock Text="Всего игр: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtStatTotalGames" Text="0" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Cores Ready -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0">
                        <TextBlock Text="Ядер готово: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtStatCoresReady" Text="0" Foreground="{DynamicResource ThemeAccent}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Total Size -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,24,0">
                        <TextBlock Text="Общий объём: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtStatTotalSize" Text="0 B" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Video Driver & Mode -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBlock Text="Движок: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                        <Border Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="4,0,0,0">
                            <TextBlock x:Name="TxtStatDriver" Text="Vulkan / Low-Latency" Foreground="{DynamicResource ThemeAccent}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Quick Start Drag & Drop Hint -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <TextBlock Text="💡 Перетащите файлы ROM, архивы или ядра прямо в окно программы" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Games Library ListView Table -->
            <Grid Grid.Row="2">
                <ListView x:Name="LvGames" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <!-- Column 0: Icon -->
                            <GridViewColumn Width="60">
                                <GridViewColumn.Header>
                                    <TextBlock Text="Иконка"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="36" Height="36" Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Column 1: Game Title & Path -->
                            <GridViewColumn Width="480">
                                <GridViewColumn.Header>
                                    <TextBlock Text="Название игры"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding FilePath}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Column 2: Platform -->
                            <GridViewColumn Width="200">
                                <GridViewColumn.Header>
                                    <TextBlock Text="Платформа"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource ThemeAccent}" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Column 3: Libretro Core -->
                            <GridViewColumn Width="180">
                                <GridViewColumn.Header>
                                    <TextBlock Text="Ядро Libretro"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CoreDisplayName}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CoreDll}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Column 4: Status & Progress -->
                            <GridViewColumn Width="180">
                                <GridViewColumn.Header>
                                    <TextBlock Text="Статус"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                                            <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4" Margin="0,4,0,0" Background="{DynamicResource ThemeBgWindow}" Foreground="{DynamicResource ThemeAccent}" Visibility="{Binding IsDownloading, Converter={x:Static local:MainWindow.BoolToVisibility}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Column 5: Size -->
                            <GridViewColumn Width="100">
                                <GridViewColumn.Header>
                                    <TextBlock Text="Размер"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Column 6: Actions -->
                            <GridViewColumn Width="190">
                                <GridViewColumn.Header>
                                    <TextBlock Text="Действия"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Play Button -->
                                            <Button Style="{StaticResource StormAccentButton}" Height="28" Padding="12,0" Margin="0,0,6,0" Tag="{Binding}" Click="BtnItemPlay_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M 0,0 L 8,5 L 0,10 Z" Fill="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Играть" FontSize="11"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Open Folder Button -->
                                            <Button Style="{StaticResource StormSecondaryButton}" Height="28" Padding="8,0" Margin="0,0,6,0" Tag="{Binding}" Click="BtnItemFolder_Click" ToolTip="Открыть папку с файлом">
                                                <Path Data="M 0,2 L 4,2 L 6,4 L 12,4 L 12,10 L 0,10 Z" Stroke="{DynamicResource ThemeTextPrimary}" StrokeThickness="1.2" Fill="Transparent"/>
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Style="{StaticResource StormSecondaryButton}" Height="28" Padding="8,0" Tag="{Binding}" Click="BtnItemDelete_Click" ToolTip="Удалить из списка">
                                                <Path Data="M 1,2 L 9,2 M 2,2 L 2,8 L 8,8 L 8,2 M 3,2 L 3,0 L 7,0 L 7,2" Stroke="#F43F5E" StrokeThickness="1.2" Fill="Transparent"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Empty State Placeholder -->
                <Border x:Name="EmptyStateBorder" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                        <Border Width="64" Height="64" Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="M 6,10 L 10,10 M 8,8 L 8,12 M 16,9 A 1,1 0 1 1 16,11 A 1,1 0 1 1 16,9 M 19,10 A 1,1 0 1 1 19,12 A 1,1 0 1 1 19,10 M 4,4 L 20,4 C 23,4 25,7 24,12 L 22,20 C 21.5,22 19.5,23 18,21 L 15,17 L 9,17 L 6,21 C 4.5,23 2.5,22 2,20 L 0,12 C -1,7 1,4 4,4 Z" Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtEmptyTitle" Text="Перетащите игры, папки или ядра сюда" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtEmptySubtitle" Text="Поддерживаются ROM-образы 30+ платформ, архивы (.zip/.7z/.rar), шейдеры (.slangp), читы и сохранения" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,20"/>
                        <Button Style="{StaticResource StormAccentButton}" Height="36" Padding="20,0" HorizontalAlignment="Center" Click="BtnAddFiles_Click">
                            <TextBlock Text="Выбрать файлы на диске..."/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== ROW 3: FOOTER ==================== -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="0,1,0,0" Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFooterStatus" Text="Готово к работе" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STORM RETROARCH • STORM AURORA FLUID" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MODALS & OVERLAYS (Closed by ESC) ==================== -->
        <!-- Overlay 1: Libretro Cores Manager -->
        <Grid x:Name="OverlayCoresManager" Background="#B0000000" Visibility="Collapsed" Grid.RowSpan="4">
            <Border Width="820" Height="580" Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtModalCoresTitle" Text="МЕНЕДЖЕР ЯДЕР LIBRETRO" Foreground="{DynamicResource ThemeAccent}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtModalCoresSubtitle" Text="Официальные ядра Libretro Buildbot с автоматической фоновой загрузкой в cores/" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="LvCores" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" Margin="0,0,0,16">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="160" Header="Ядро" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Width="220" Header="Платформа" DisplayMemberBinding="{Binding Platform}"/>
                                <GridViewColumn Width="190" Header="Файл DLL" DisplayMemberBinding="{Binding DllName}"/>
                                <GridViewColumn Width="180" Header="Действие">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource StormAccentButton}" Height="26" Padding="10,0" Tag="{Binding}" Click="BtnDownloadCoreItem_Click">
                                                <TextBlock Text="Скачать / Обновить" FontSize="11"/>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Grid Grid.Row="2">
                        <Button Style="{StaticResource StormAccentButton}" Content="⭐ СКАЧАТЬ ЗОЛОТОЙ НАБОР ЯДЕР" HorizontalAlignment="Left" Height="36" Padding="18,0" Click="BtnDownloadGoldenCores_Click"/>
                        <Button Style="{StaticResource StormSecondaryButton}" Content="Закрыть (ESC)" HorizontalAlignment="Right" Height="36" Padding="20,0" Click="BtnCloseModals_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay 2: Engine Settings & Turbo Profile -->
        <Grid x:Name="OverlayEngineSettings" Background="#B0000000" Visibility="Collapsed" Grid.RowSpan="4">
            <Border Width="640" Height="480" Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="НАСТРОЙКИ ДВИЖКА И ТУРБО-ПРОФИЛЬ" Foreground="{DynamicResource ThemeAccent}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Оптимизация задержки вывода, синхронизации кадров и звукового тракта" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <!-- Video Driver -->
                        <TextBlock Text="Графический драйвер:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbVideoDriver" Height="34" Margin="0,0,0,16"/>

                        <!-- Low Latency Switches -->
                        <CheckBox x:Name="ChkPreemptive" Content="Preemptive Frames (Нулевая задержка ввода / Run-Ahead)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkVrr" Content="Синхронизация VRR / G-Sync / FreeSync (120–240 Гц)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkWasapi" Content="Аудиодрайвер WASAPI Low-Latency (минимальный буфер)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkInteger" Content="Целочисленное масштабирование 1:1 (Integer Scaling)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <!-- Shaders -->
                        <TextBlock Text="Пресет шейдера:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbShaders" Height="34"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Button Style="{StaticResource StormAccentButton}" Content="Сохранить настройки" HorizontalAlignment="Left" Height="36" Padding="20,0" Click="BtnSaveEngineSettings_Click"/>
                        <Button Style="{StaticResource StormSecondaryButton}" Content="Закрыть (ESC)" HorizontalAlignment="Right" Height="36" Padding="20,0" Click="BtnCloseModals_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay 3: Update Modal -->
        <Grid x:Name="OverlayUpdate" Background="#B0000000" Visibility="Collapsed" Grid.RowSpan="4">
            <Border Width="600" Height="420" Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="ДОСТУПНО ОБНОВЛЕНИЕ" Foreground="{DynamicResource ThemeAccent}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtUpdateSubtitle" Text="Найдена новая версия программы" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtUpdateChangelog" Text="" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <ProgressBar Grid.Row="2" x:Name="PbUpdate" Maximum="100" Height="6" Margin="0,0,0,16" Visibility="Collapsed" Foreground="{DynamicResource ThemeAccent}" Background="{DynamicResource ThemeBgCard}"/>

                    <Grid Grid.Row="3">
                        <Button x:Name="BtnUpdateConfirm" Style="{StaticResource StormAccentButton}" Content="Обновить" HorizontalAlignment="Left" Height="36" Padding="24,0" Click="BtnUpdateConfirm_Click"/>
                        <Button Style="{StaticResource StormSecondaryButton}" Content="Закрыть (ESC)" HorizontalAlignment="Right" Height="36" Padding="20,0" Click="BtnCloseModals_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay 4: About Modal -->
        <Grid x:Name="OverlayAbout" Background="#B0000000" Visibility="Collapsed" Grid.RowSpan="4">
            <Border Width="640" Height="460" Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="О ПРОГРАММЕ STORM RETROARCH" Foreground="{DynamicResource ThemeAccent}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Флагманский фронтенд и эмулятор экосистемы STORM GAMES WORLD" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Border Background="{DynamicResource ThemeBgCard}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="STORM RETROARCH 1.0.0" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Высокопроизводительный фронтенд Libretro с поддержкой более 30 консольных платформ, ультра-низкой задержкой вывода через Vulkan и Direct3D, встроенной системой фоновой загрузки ядер и универсальным Drag-and-Drop." Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Unified Hidden Certificate & Signature Badge -->
                        <Border Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="ЕДИНЫЙ СКРЫТЫЙ СЕРТИФИКАТ ЭКОСИСТЕМЫ STORM" Foreground="{DynamicResource ThemeAccent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="STORM-AURORA-FLUID-CERT-2026-RETROARCH-ORIGINAL-AUTHENTIC-BUILD-VERIFIED" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="10" FontFamily="Consolas"/>
                                <TextBlock Text="SIGNATURE: STORM TEAM 2026 • ALL RIGHTS SECURED" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="2" Style="{StaticResource StormSecondaryButton}" Content="Закрыть (ESC)" HorizontalAlignment="Right" Height="36" Padding="24,0" Click="BtnCloseModals_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
