                                                <TextBlock Text="Живая студия ЭЛТ-луча и кинескопа" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 6 1-Click Preset Pills -->
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="BtnPresetTrinitron" Content="Sony Trinitron" Style="{StaticResource CapsuleButton}" Tag="Active" Margin="0,0,6,4" Click="BtnShaderPreset_Click"/>
                                            <Button x:Name="BtnPresetArcade" Content="Arcade RGB" Style="{StaticResource CapsuleButton}" Margin="0,0,6,4" Click="BtnShaderPreset_Click"/>
                                            <Button x:Name="BtnPresetVga" Content="IBM DOS VGA" Style="{StaticResource CapsuleButton}" Margin="0,0,6,4" Click="BtnShaderPreset_Click"/>
                                            <Button x:Name="BtnPresetGbLcd" Content="Game Boy LCD" Style="{StaticResource CapsuleButton}" Margin="0,0,6,4" Click="BtnShaderPreset_Click"/>
                                            <Button x:Name="BtnPresetVhs" Content="VHS Ретро" Style="{StaticResource CapsuleButton}" Margin="0,0,6,4" Click="BtnShaderPreset_Click"/>
                                            <Button x:Name="BtnPresetClean" Content="Чистый пиксель" Style="{StaticResource CapsuleButton}" Margin="0,0,6,4" Click="BtnShaderPreset_Click"/>
                                        </WrapPanel>

                                        <!-- 3x2 UniformGrid of 6 Sliders -->
                                        <UniformGrid Columns="3" Rows="2">
                                            <!-- 1. Scanlines -->
                                            <Border Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,6">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True" Margin="0,0,0,4">
