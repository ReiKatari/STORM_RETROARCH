                                                <ComboBoxItem Content="libx264 (H.264 CPU)" IsSelected="True"/>
                                                <ComboBoxItem Content="hevc_nvenc (H.265 Nvidia)"/>
                                                <ComboBoxItem Content="Lossless Без сжатия"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkRecordWithShaders" Content="Записывать с шейдерами и рамкой Bezel" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                    <Button Content=" Открыть папку видеозаписей" Style="{StaticResource StormSecondaryButton}" HorizontalAlignment="Left" Click="BtnOpenRecordingsDir_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
