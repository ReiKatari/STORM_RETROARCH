                                                <DataTemplate>
                                                    <Border Padding="8,4" MinHeight="54">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="▶ Играть" Style="{StaticResource StormAccentButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnPlayGame_Click"/>
                                                            <Button Style="{StaticResource StormSecondaryButton}" Padding="7,4" Click="BtnOpenRomFolder_Click" ToolTip="Открыть папку с файлом игры">
                                                                <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#38BDF8" Stretch="Uniform" Width="12" Height="12"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Border x:Name="EmptyHistoryBorder" Visibility="Collapsed" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="История запусков пуста" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Запустите любую игру из раздела «Все игры», чтобы она автоматически сохранилась в журнале запусков" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- VIEW 6:  МЕНЕДЖЕР ЯДЕР (CORE DOWNLOADER) -->
                <Grid x:Name="ViewCores" Visibility="Collapsed" Margin="22,14">
                    <DockPanel LastChildFill="True">
                        <!-- Top Header -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Менеджер и загрузчик ядер" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Каталог официальных сборок Libretro Buildbot (350+ ядер) и Золотой набор эмуляторов STORM" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StormAccentButton}" Margin="0,0,8,0" Click="BtnDownloadGoldenCores_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M7 2v11h3v9l7-12h-4l4-8z" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Золотой набор ядер (25)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormSecondaryButton}" Click="BtnUpdateCores_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Fill="#34D399" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Обновить список" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Manufacturer Filter Chips -->
                        <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12" DockPanel.Dock="Top">
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="Все ядра (350+)" Style="{StaticResource CategoryChipButton}" Tag="Active" Margin="0,0,6,4" Click="BtnCoreFilter_Click"/>
                                <Button Content="Золотой набор (25)" Style="{StaticResource CategoryChipButton}" Margin="0,0,6,4" Click="BtnCoreFilter_Click"/>
                                <Button Content="Nintendo" Style="{StaticResource CategoryChipButton}" Margin="0,0,6,4" Click="BtnCoreFilter_Click"/>
                                <Button Content="Sega" Style="{StaticResource CategoryChipButton}" Margin="0,0,6,4" Click="BtnCoreFilter_Click"/>
                                <Button Content="Sony" Style="{StaticResource CategoryChipButton}" Margin="0,0,6,4" Click="BtnCoreFilter_Click"/>
                                <Button Content="Arcade" Style="{StaticResource CategoryChipButton}" Margin="0,0,6,4" Click="BtnCoreFilter_Click"/>
                                <Button Content="Atari" Style="{StaticResource CategoryChipButton}" Margin="0,0,6,4" Click="BtnCoreFilter_Click"/>
                                <Button Content="PC / DOS" Style="{StaticResource CategoryChipButton}" Margin="0,0,6,4" Click="BtnCoreFilter_Click"/>
                                <Button Content="Commodore" Style="{StaticResource CategoryChipButton}" Margin="0,0,6,4" Click="BtnCoreFilter_Click"/>
                                <Button Content="SNK" Style="{StaticResource CategoryChipButton}" Margin="0,0,6,4" Click="BtnCoreFilter_Click"/>
                                <Button Content="Other" Style="{StaticResource CategoryChipButton}" Margin="0,0,6,4" Click="BtnCoreFilter_Click"/>
                            </WrapPanel>
                        </Border>

                        <!-- Dynamic View Mode Containers for Cores -->
                        <Grid>
                            <!-- Mode 1: Bento Cards (Tiles) -->
                            <ScrollViewer x:Name="ScrollCoresTiles" VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="PanelCoresTiles" Margin="0,4"/>
                            </ScrollViewer>

                            <!-- Mode 2: Ozone List (Rows) -->
                            <ScrollViewer x:Name="ScrollCoresList" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel x:Name="PanelCoresList" Margin="0,4"/>
                            </ScrollViewer>

                            <!-- Mode 3: Compact Grid (Icons) -->
                            <ScrollViewer x:Name="ScrollCoresCompact" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <WrapPanel x:Name="PanelCoresCompact" Margin="0,4"/>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- VIEW 7:  СЕТЕВАЯ ИГРА (NETPLAY) -->
                <Grid x:Name="ViewNetplay" Visibility="Collapsed" Margin="22,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Сетевая игра по сети" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Совместное прохождение классических игр по локальной сети и через серверы Libretro" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" Margin="0,0,0,16"/>

                            <!-- Host Room -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Создать игровую комнату" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Название комнаты:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtNetplayHostRoom" Text="STORM Room #1"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Порт:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtNetplayHostPort" Text="55435"/>
                                    </Grid>
                                    <Button Content=" Запустить сервер комнаты" Style="{StaticResource StormAccentButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnStartNetplayHost_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Join Room -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Подключиться к комнате" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="IP или домен хоста:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtNetplayJoinIp" Text="127.0.0.1"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Порт:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtNetplayJoinPort" Text="55435"/>
                                    </Grid>
                                    <Button Content=" Подключиться по IP" Style="{StaticResource StormSecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnJoinNetplay_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Live Netplay Lobby -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Открытые сетевые комнаты" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold"/>
                                        <Button Content=" Обновить лобби" Style="{StaticResource StormSecondaryButton}" HorizontalAlignment="Right" Click="BtnRefreshLobby_Click"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="ItemsNetplayLobby">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,6" Padding="10">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Content="Подключиться" Style="{StaticResource StormAccentButton}" DockPanel.Dock="Right" Padding="10,4" Tag="{Binding}" Click="BtnJoinLobbyRoom_Click"/>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding GameName}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="13"/>
                                                                <Border Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0">
                                                                    <TextBlock Text="{Binding CoreName}" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="10.5" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding Username, StringFormat='{}Хост: {0}'}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,14,0"/>
                                                                <TextBlock Text="{Binding Country, StringFormat='{}Регион: {0}'}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="0,0,14,0"/>
                                                                <TextBlock Text="{Binding IpPort, StringFormat='{}Адрес: {0}'}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 8: ️ СКРИНШОТЫ (SCREENSHOTS) -->
                <Grid x:Name="ViewScreenshots" Visibility="Collapsed" Margin="22,14">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Галерея скриншотов и захватов" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtScreenshotsDirDisplay" Text="Папка: screenshots/" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StormAccentButton}" Margin="0,0,8,0" Click="BtnGenerateShowcase_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Создать SHOWCASE.png" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Click="BtnRecordClip_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4z" Fill="#FB7185" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Запись клипа 60 FPS" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource StormSecondaryButton}" Click="BtnOpenScreenshotsFolder_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#38BDF8" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Папка" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="WrapScreenshots" Margin="0,4"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- VIEW 9:  ИМПОРТ КОНТЕНТА (IMPORT) -->
                <Grid x:Name="ViewImport" Visibility="Collapsed" Margin="22,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="920" HorizontalAlignment="Left">
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="⚡ Перейти к читам и тренерам игр" Style="{StaticResource StormAccentButton}" Padding="14,7" FontWeight="Bold" Click="BtnSwitchToCheatsView_Click"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Многодисковые игры, сканер каталогов и патчи образов" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Генератор плейлистов многодисковых игр (.m3u), применение патчей перевода (.ips / .bps) и пакетное сканирование папок" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Card 1: Scan Directory -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Сканировать папку с играми" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="Рекурсивно просканировать всю папку с играми и автоматически привязать оптимальные ядра Libretro" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" Margin="0,0,0,12"/>
                                    <Button Content=" Выбрать папку для сканирования..." Style="{StaticResource StormAccentButton}" HorizontalAlignment="Left" Click="BtnAddFolder_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Scan Single File -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Добавить отдельный файл игры" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="Добавить один образ игры (.nes, .sfc, .md, .bin, .iso, .chd, .n64, .gba, .zip)" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" Margin="0,0,0,12"/>
                                    <Button Content=" Выбрать файл игры..." Style="{StaticResource StormSecondaryButton}" HorizontalAlignment="Left" Click="BtnAddFiles_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Multi-Disc M3U Playlist Generator -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text=" Генератор плейлистов многодисковых игр (.m3u)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="Автоматическое создание единого .m3u плейлиста для PS1, Saturn, Dreamcast, Sega CD и 3DO игр" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Название игры:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtM3uGameTitle" Text="Final Fantasy VII"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtM3uSelectedFiles" Text="Выбрано дисков: 0" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="12" Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content=" Выбрать образы дисков..." Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Click="BtnSelectM3uFiles_Click"/>
                                        <Button Content=" Создать .m3u плейлист" Style="{StaticResource StormAccentButton}" Margin="0,0,16,0" Click="BtnGenerateM3u_Click"/>
                                    </WrapPanel>

                                    <!-- Quick Disc Swap Controls via UDP -->
                                    <Border Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Управление виртуальным дисководом:" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Content="⏏️ Открыть/Закрыть лоток" Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Padding="8,4" Click="BtnDiscEjectToggle_Click"/>
                                            <Button Content="⏮️ Пред. диск" Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Padding="8,4" Click="BtnDiscPrev_Click"/>
                                            <Button Content="⏭️ След. диск" Style="{StaticResource StormSecondaryButton}" Padding="8,4" Click="BtnDiscNext_Click"/>
                                        </WrapPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Soft & Hard Patching (.IPS, .BPS, .UPS) -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text=" Наложение патчей русификаторов (.ips / .bps / .ups)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="Мягкая привязка (Soft-patching на лету без изменения ROM) или прямое наложение IPS-патча" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Файл ROM:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtPatchRomPath" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="Обзор..." Style="{StaticResource StormSecondaryButton}" Padding="10,4" Click="BtnSelectPatchRom_Click"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Файл патча:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtPatchFilePath" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="Обзор..." Style="{StaticResource StormSecondaryButton}" Padding="10,4" Click="BtnSelectPatchFile_Click"/>
                                    </Grid>
                                    <WrapPanel>
                                        <Button Content=" Привязать мягкий патч" Style="{StaticResource StormAccentButton}" Margin="0,0,8,0" Click="BtnAttachSoftPatch_Click"/>
                                        <Button Content=" Применить патч напрямую к файлу" Style="{StaticResource StormSecondaryButton}" Margin="0,0,8,0" Click="BtnApplyIpsPatch_Click"/>
                                        <Button Content="️ Запустить Super Game Boy..." Style="{StaticResource StormSecondaryButton}" Click="BtnLaunchSuperGameBoy_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- VIEW 10:  ШЕЙДЕРЫ И ФИЛЬТРЫ (SHADERS & FILTERS) -->
                <Grid x:Name="ViewShaders" Visibility="Collapsed" Margin="22,14">
                    <DockPanel LastChildFill="True">
                        <!-- Header & Action Bar -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
