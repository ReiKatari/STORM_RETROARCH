            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/> <!-- Col 0: RetroArch Left Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Col 1: Main Content Workspace -->
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT SIDEBAR ==================== -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- Top Logo Badge -->
                    <Border DockPanel.Dock="Top" Margin="10,12,10,10" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                        <DockPanel>
                            <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" Margin="0,0,8,0">
                                <Path Data="M5,14 L11,7 L17,14 L23,7" Stroke="{DynamicResource ThemeAccentGlow}" StrokeThickness="2" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="12.5">
                                    <Run Text="STORM" Foreground="{DynamicResource ThemeAccent}" FontWeight="Black"/><Run Text=" RETROARCH" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Black"/>
                                </TextBlock>
                                <TextBlock Text="МУЛЬТИПЛАТФОРМЕННЫЙ ЭМУЛЯТОР" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Bottom Sidebar Actions -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,8">
                        <Button Content="💾 Сохранить .cfg" Style="{StaticResource StormAccentButton}" Margin="0,0,0,4" Click="BtnSaveConfig_Click"/>
                        <Button Content="↩ Сброс настроек" Style="{StaticResource StormSecondaryButton}" Margin="0,0,0,6" Click="BtnResetConfig_Click"/>
                        
                    </StackPanel>

                    <!-- Navigation Items List (9 Sections) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                        <StackPanel Margin="2,0">
                            <!-- GROUP 1: ОСНОВНОЕ -->
                            <TextBlock Text="ОСНОВНОЕ" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10" FontWeight="Bold" Margin="10,8,0,4"/>
                            
                            <Button x:Name="NavBtnMainMenu" Style="{StaticResource SidebarNavButton}" Tag="Active" Click="NavBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="#2038BDF8" BorderBrush="#6038BDF8" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
