                            <!-- Живая студия ЭЛТ-луча и пост-обработки (2.0.0 Pro-Emulator) -->
                            <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeAccentGlow}" BorderThickness="1.5" CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="360"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 0: Controls & 6 Sliders -->
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
