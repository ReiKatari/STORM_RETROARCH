                <!-- VIEW 9: ➕ ИМПОРТ КОНТЕНТА (IMPORT) -->
                <Grid x:Name="ViewImport" Visibility="Collapsed" Margin="22,14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Импорт контента (Scan Directory / File)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Сканирование каталогов и добавление ROM-файлов с автоматическим определением платформы" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" Margin="0,0,0,16"/>

                            <!-- Card 1: Scan Directory -->
