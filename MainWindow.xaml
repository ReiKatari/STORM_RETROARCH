                                        </DockPanel>
                                        <TextBlock Text="Для корректного зачёта достижений контрольная сумма CRC32 ROM-файла должна точно совпадать с базой RetroAchievements.org" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5" Margin="0,0,0,10"/>

                                        <ItemsControl x:Name="ItemsCheevosLibrary">
