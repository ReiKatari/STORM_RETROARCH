                    <!-- Row 0: STORM In-Game Studio Command Deck (4 Structured Capsule Groups) -->
                    <Border x:Name="InGameHudBorder" Grid.Row="0" Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- GROUP 1: СЕССИЯ И НАВИГАЦИЯ -->
                            <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="6,4" Margin="0,0,8,0" VerticalAlignment="Center">
