                                    <Border Width="26" Height="26" CornerRadius="6" Background="#20FB7185" BorderBrush="#60FB7185" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="M20 12h-2V8h-4V6a2 2 0 0 0-4 0v2H6a2 2 0 0 0-2 2v4h2a2 2 0 0 1 0 4H4v4a2 2 0 0 0 2 2h4v-2a2 2 0 0 1 4 0v2h4a2 2 0 0 0 2-2v-4h-2a2 2 0 0 1 0-4h2v-4a2 2 0 0 0-2-2z" Fill="#FB7185" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Менеджер ядер" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnCoreOptions" Style="{StaticResource SidebarNavButton}" Click="NavBtn_Click">
