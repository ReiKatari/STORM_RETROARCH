                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Внешние эмуляторы (PCSX2, RPCS3, Vita3K, Switch, Dolphin, Cemu, Xenia) и импорт .lpl" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" Margin="0,0,0,3"/>
