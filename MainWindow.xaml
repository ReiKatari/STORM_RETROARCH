                                                <!-- Row 4: Actions -->
                                                <DockPanel Grid.Row="4" LastChildFill="True">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource ThemeSurfaceHover}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding AspectRatio}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5"/>
                                                        </Border>
                                                        <Border Background="#1A38BDF8" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PackSource}" Foreground="#7DD3FC" FontSize="10.5" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Button Visibility="{Binding DeleteButtonVisibility}" Style="{StaticResource StormSecondaryButton}" Padding="6,4" Tag="{Binding}" Click="BtnDeleteBezel_Click" ToolTip="Удалить рамку">
                                                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Fill="#FB7185" Width="11" Height="11" Stretch="Uniform"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <Button Style="{StaticResource StormAccentButton}" HorizontalAlignment="Right" Padding="12,5" Tag="{Binding}" Click="BtnApplyBezelPreset_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="#FFFFFF" Stretch="Uniform" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Применить рамку" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- VIEW 15:  ОПЦИИ ЯДЕР И ПЕРЕОПРЕДЕЛЕНИЯ (CORE OPTIONS & OVERRIDES) -->
                <Grid x:Name="ViewCoreOptions" Visibility="Collapsed" Margin="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Pane: Core Profiles List (Width="280") -->
                        <Border Grid.Column="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="ПРОФИЛИ ЯДЕР" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="14 оптимизированных ядер" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="LstCoreProfiles" Background="Transparent" BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="LstCoreProfiles_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,8" HorizontalAlignment="Stretch">
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Platform}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="4" Padding="6,2" Background="{DynamicResource ThemeSurfaceLight}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Options.Count, StringFormat='{}{0} опций'}" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Right Pane: Studio Options Deck (Width="*") -->
                        <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel LastChildFill="True">
                                <!-- Header & Actions -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource StormSecondaryButton}" Margin="0,0,6,0" Padding="10,5" Click="BtnResetCoreOptions_Click" ToolTip="Сбросить все параметры к значениям по умолчанию">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Fill="#FB7185" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Сбросить" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource StormAccentButton}" Margin="0,0,6,0" Padding="12,5" Click="BtnSaveCoreOptions_Click" ToolTip="Сохранить в config/[Core]/[Core].opt">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M17 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" Fill="#FFFFFF" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Сохранить .opt" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource StormSecondaryButton}" Padding="10,5" Click="BtnSaveCoreOverride_Click" ToolTip="Сохранить Override .cfg">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="#38BDF8" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Профиль игры" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSelectedCoreProfileName" Text="SwanStation" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="18" FontWeight="Bold"/>
                                            <Border Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtSelectedCorePlatform" Text="Sony PlayStation (PS1)" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Search & Category Chips -->
                                <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                    <DockPanel LastChildFill="True">
                                        <!-- Search Box -->
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2" Width="200" Margin="10,0,0,0">
                                            <DockPanel LastChildFill="True">
                                                <Path DockPanel.Dock="Left" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="{DynamicResource ThemeTextMuted}" Stretch="Uniform" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtCoreOptionSearch" Tag="Поиск параметров..." Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11.5" VerticalAlignment="Center" TextChanged="TxtCoreOptionSearch_TextChanged"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- Category Chips -->
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Все параметры" Style="{StaticResource CategoryChipButton}" Tag="Active" Margin="0,0,4,0" Click="BtnCoreOptionCategory_Click"/>
                                            <Button Content="Видео и палитра" Style="{StaticResource CategoryChipButton}" Margin="0,0,4,0" Click="BtnCoreOptionCategory_Click"/>
                                            <Button Content="Разрешение и фильтрация" Style="{StaticResource CategoryChipButton}" Margin="0,0,4,0" Click="BtnCoreOptionCategory_Click"/>
                                            <Button Content="Процессор и точность" Style="{StaticResource CategoryChipButton}" Margin="0,0,4,0" Click="BtnCoreOptionCategory_Click"/>
                                            <Button Content="Аудио и звуковые чипы" Style="{StaticResource CategoryChipButton}" Margin="0,0,4,0" Click="BtnCoreOptionCategory_Click"/>
                                            <Button Content="Ввод и системные функции" Style="{StaticResource CategoryChipButton}" Click="BtnCoreOptionCategory_Click"/>
                                        </WrapPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Options List -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ItemsCoreOptions">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeBgWindow}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="14,10" HorizontalAlignment="Stretch">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Col 0: Category + Key + Title + Description -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                <Border Background="{DynamicResource ThemeSurfaceLight}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="10" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" FontFamily="Consolas, monospace" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="13"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Col 1: ComboBox Value + Reset Button -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay}" Width="220" Height="28" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                                                            <Button Content="↺" Style="{StaticResource CapsuleButton}" Padding="8,4" ToolTip="Сбросить к значению по умолчанию" Tag="{Binding}" Click="BtnResetSingleOption_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
<!-- VIEW 16: СТУДИЯ УСТРОЙСТВ ВВОДА И ГОРЯЧИХ КЛАВИШ (INPUT REMAP & MULTI-DEVICE STUDIO) -->
                <Grid x:Name="ViewInputRemap" Visibility="Collapsed" Margin="22,14">
                    <DockPanel LastChildFill="True">
                        <!-- Top Header & Device Profile Bar (Multi-Row: Row 1 = Title + SubTabs, Row 2 = Controls) -->
                        <Border x:Name="BdrDeviceStudioBar" DockPanel.Dock="Top" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Row 1: Header + Sub-View Switcher Pills -->
                                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Border Background="#14FFFFFF" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="9" Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnSubTabDeviceMap" Content="Кнопки и контроллер" Style="{StaticResource CapsuleButton}" Tag="Active" Padding="12,5" FontSize="11.5" FontWeight="Bold" Click="BtnSubTab_Click"/>
                                                <Button x:Name="BtnSubTabHotkeysStudio" Content="Горячие клавиши и аккорды (18)" Style="{StaticResource CapsuleButton}" Padding="12,5" FontSize="11.5" FontWeight="Bold" Click="BtnSubTab_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Устройства ввода, аркадные стики и горячие клавиши" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Индивидуальные профили геймпадов, аркадных стиков, авиаджойстиков HOTAS и рулей с автоподгрузкой под каждое ядро и игру" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Row 2: Device, Visual Form-Factor & Auto-Switch Scope Bar -->
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,4">
                                        <TextBlock Text="Устройство:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbActiveDeviceProfile" Width="250" Height="28" VerticalContentAlignment="Center" SelectionChanged="CmbActiveDeviceProfile_SelectionChanged"/>
                                    </StackPanel>

                                    <Border x:Name="BdrDeviceConnBadge" Background="#1A10B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,12,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtDeviceConnBadge" Text="Активен • Автопрофиль" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,4">
                                        <TextBlock Text="Иллюстрация:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbControllerStyle" Width="210" Height="28" VerticalContentAlignment="Center" SelectionChanged="CmbControllerStyle_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,4">
                                        <TextBlock Text="Привязка к ядру:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbDeviceCoreScope" Width="190" Height="28" VerticalContentAlignment="Center" SelectionChanged="CmbDeviceCoreScope_SelectionChanged"/>
                                    </StackPanel>

                                    <CheckBox x:Name="ChkDeviceAutoLoad" Content="Автоподгрузка при включении" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,4" FontSize="11"/>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <Button x:Name="BtnSaveDeviceLayer" Style="{StaticResource StormAccentButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnSaveDeviceLayer_Click" ToolTip="Сохранить текущие назначения в профиль устройства">
                                            <TextBlock Text="Сохранить профиль" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="BtnCloneDeviceProfile" Style="{StaticResource StormSecondaryButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnCloneDeviceProfile_Click" ToolTip="Создать копию профиля с новыми настройками">
                                            <TextBlock Text="Новый профиль" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="BtnRefreshDevices" Style="{StaticResource StormSecondaryButton}" Padding="10,4" Click="BtnRefreshDevices_Click" ToolTip="Пересканировать USB/Bluetooth контроллеры">
                                            <TextBlock Text="Обновить порты" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- SUB-VIEW 1: КНОПКИ И КОНТРОЛЛЕР (Controller Visualizer & Remapping) -->
                        <Grid x:Name="PnlSubViewControllerMap">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="480"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Card: Realistic Controller Preview & Hardware Controls -->
                            <Border Grid.Column="0" Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1.5" CornerRadius="12" Padding="14" Margin="0,0,12,0">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDeviceHardwareInfo" Text="VID: 0x045E • PID: 0x02FD • XInput Порт 1" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <WrapPanel Orientation="Horizontal">
                                            <Border x:Name="BdrDeviceCoreBadge" Background="#1A8B5CF6" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,6,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtDeviceCoreBadge" Text="Слой: Глобально" Foreground="#C4B5FD" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border x:Name="BadgeGamepadCapture" Visibility="Collapsed" Background="#2010B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="0,0,0,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtGamepadCaptureStatus" Text="Захват кнопки..." Foreground="#34D399" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Controller Graphic Image -->
                                    <Border DockPanel.Dock="Top" Background="#0C0A14" BorderBrush="#252033" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,10" HorizontalAlignment="Center">
                                        <Image x:Name="ImgRealisticController" Width="440" Height="230" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Telemetry Readout -->
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,0,0,10">
                                        <TextBlock x:Name="TxtLivePadTelemetry" Text="Подключён • Оси L:(0%, 0%) • LT:0% RT:0%" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Border>

                                    <!-- Hardware Sliders & Options -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- Deadzone Slider -->
                                            <Border Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                                        <TextBlock x:Name="TxtAnalogDeadzoneVal" Text="15%" DockPanel.Dock="Right" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="11.5" FontWeight="Bold"/>
                                                        <TextBlock Text="Мёртвая зона стиков" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                                    </DockPanel>
                                                    <Slider x:Name="SliderAnalogDeadzone" Minimum="5" Maximum="40" Value="15" ValueChanged="SliderAnalogDeadzone_ValueChanged"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Trigger Threshold Slider -->
                                            <Border Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                                        <TextBlock x:Name="TxtTriggerThresholdVal" Text="12%" DockPanel.Dock="Right" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold"/>
                                                        <TextBlock Text="Порог курков LT / RT" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                                    </DockPanel>
                                                    <Slider x:Name="SliderTriggerThreshold" Minimum="5" Maximum="50" Value="12" ValueChanged="SliderTriggerThreshold_ValueChanged"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Rumble & Turbo -->
                                            <Border Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                <DockPanel LastChildFill="True">
                                                    <Button x:Name="BtnTestRumble" DockPanel.Dock="Right" Style="{StaticResource StormSecondaryButton}" Padding="8,4" VerticalAlignment="Center" Click="BtnTestRumble_Click" ToolTip="Проверить вибрацию на текущем порте">
                                                        <TextBlock Text="Тест вибрации" FontSize="11"/>
                                                    </Button>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox x:Name="ChkRumbleEnabled" Content="Виброотдача XInput" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Click="ChkRumbleEnabled_Click"/>
                                                        <CheckBox x:Name="ChkTurboButtons" Content="Турбо-огонь" IsChecked="False" VerticalAlignment="Center" Margin="0,0,6,0" Click="ChkTurboButtons_Click"/>
                                                        <ComboBox x:Name="CmbTurboFireHz" Width="76" Height="24" VerticalAlignment="Center" SelectionChanged="CmbTurboFireHz_SelectionChanged">
                                                            <ComboBoxItem Content="5 Гц"/>
                                                            <ComboBoxItem Content="10 Гц"/>
                                                            <ComboBoxItem Content="15 Гц" IsSelected="True"/>
                                                            <ComboBoxItem Content="30 Гц"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Right Card: Button Remapping List -->
                            <Border Grid.Column="1" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                                <DockPanel LastChildFill="True">
                                    <!-- Player Port Chips 1..8 -->
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeBgInput}" BorderBrush="{DynamicResource ThemeBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Порт:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
