                    </ScrollViewer>
                </Grid>

                <!-- VIEW 10:  ШЕЙДЕРЫ И ФИЛЬТРЫ (SHADERS & FILTERS) -->
                <Grid x:Name="ViewShaders" Visibility="Collapsed" Margin="22,14">
                    <DockPanel LastChildFill="True">
                        <!-- Header & Action Bar -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
