            <!-- ==================== INTERACTIVE SIDEBAR GRIDSPLITTER ==================== -->
            <GridSplitter x:Name="SidebarSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="False"
                          DragCompleted="SidebarSplitter_DragCompleted"
                          ToolTip="Перетащите влево или вправо для изменения ширины бокового меню">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="#01000000">
                            <Border x:Name="SplitLine" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource ThemeBorderSubtle}"/>
                            <Border x:Name="SplitHandle" Width="4" Height="42" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ThemeBorder}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SplitLine" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="SplitHandle" Property="Background" Value="{DynamicResource ThemeAccentGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ==================== RIGHT CONTENT WORKSPACE ==================== -->
            <Grid x:Name="RightWorkspaceGrid" Grid.Column="2" Background="{DynamicResource ThemeBgWindow}">

                                <!-- VIEW:  ЭКРАН ИГРЫ (IN-APP EMBEDDED GAME VIEWPORT & STORM HUD) -->
                <Grid x:Name="ViewGamePlayer" Visibility="Collapsed" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- STORM In-Game HUD Bar -->
                        <RowDefinition Height="*"/>    <!-- Embedded Game Viewport -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: STORM In-Game Studio Command Deck (4 Structured Capsule Groups) -->
                    <Border x:Name="InGameHudBorder" Grid.Row="0" Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CAPSULE 1: МЕНЮ И ИНФО (← К играм, Меню F1, Game Title, Core & Device Badges) -->
