                                                                <TextBlock Text="{Binding CoreDisplayName}" Foreground="#C4B5FD" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                <TextBlock Text=" ▾" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Последний запуск" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="10,4" MinHeight="54">
                                                        <TextBlock Text="{Binding LastPlayedFormatted}" Foreground="#34D399" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Размер" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Margin="-6,0" Padding="10,4" MinHeight="54">
                                                        <TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource ThemeTextMuted}" VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Действия" Width="160">
