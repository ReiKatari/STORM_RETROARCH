                    <TextBlock Text="100% LIBRETRO COMPATIBLE" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtFooterStatus" Text="Готово к работе" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ==================== MODAL OVERLAYS ==================== -->

        <!-- 1. STORM ALERT OVERLAY (100% Modal, ZERO MessageBox.Show) -->
        <Grid x:Name="StormAlertOverlay" Visibility="Collapsed" Background="#C805050A">
            <Border Background="{DynamicResource ThemeBgHeader}" 
                    BorderBrush="{DynamicResource ThemeAccent}" 
                    BorderThickness="1.5" 
                    CornerRadius="12" 
                    Width="480" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Padding="24" 
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#000000" Opacity="0.8" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource ThemeAccentSoft}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1" Margin="0,0,10,0">
                            <Path Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M13,17 L11,17 L11,15 L13,15 L13,17 Z M13,13 L11,13 L11,7 L13,7 L13,13 Z" 
                                  Fill="{DynamicResource ThemeAccentGlow}" 
                                  Width="16" Height="16" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtAlertTitle" Text="STORM RETROARCH" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    
                    <TextBlock x:Name="TxtAlertMessage" 
                               Text="Сообщение" 
                               Foreground="{DynamicResource ThemeTextSecondary}" 
                               FontSize="13" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,22" 
                               LineHeight="20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnAlertCancel" Content="Отмена" Style="{StaticResource StormSecondaryButton}" Width="95" Margin="0,0,10,0" Visibility="Collapsed" Click="BtnAlertCancel_Click"/>
                        <Button x:Name="BtnAlertOk" Content="OK" Style="{StaticResource StormAccentButton}" Width="95" Click="BtnAlertOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. OVERLAY: UPDATE MANAGER -->
        <Grid x:Name="OverlayUpdate" Visibility="Collapsed" Background="#C805050A">
            <Border Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="12" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Доступно обновление" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtUpdateSubtitle" Text="Новая версия STORM RETROARCH готова к загрузке" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" Margin="0,0,0,14"/>

                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" MaxHeight="140">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtUpdateChangelog" Text="Список изменений..." Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" FontSize="12"/>
                        </ScrollViewer>
                    </Border>

                    <ProgressBar x:Name="PbUpdate" Height="8" Margin="0,0,0,18" Visibility="Collapsed" Background="{DynamicResource ThemeBorderSubtle}" Foreground="{DynamicResource ThemeAccent}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Позже" Style="{StaticResource StormSecondaryButton}" Width="95" Margin="0,0,10,0" Click="BtnCloseUpdate_Click"/>
                        <Button x:Name="BtnUpdateConfirm" Content="Обновить" Style="{StaticResource StormAccentButton}" Width="110" Click="BtnUpdateConfirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. OVERLAY: ABOUT -->
        <Grid x:Name="OverlayAbout" Visibility="Collapsed" Background="#C805050A">
            <Border Background="{DynamicResource ThemeBgHeader}" BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.5" CornerRadius="12" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Image Source="app_icon.png" Width="44" Height="44" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="STORM RETROARCH 1.0.0" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="STORM AURORA FLUID UNIFIED DESIGN SYSTEM" Foreground="{DynamicResource ThemeAccentGlow}" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Полнофункциональная улучшенная реплика RetroArch с интеграцией Libretro ядер, поддержкой низких задержек (Preemptive Frames, VRR G-Sync/FreeSync, WASAPI), встроенным онлайн-обновлением, менеджером сейвов и 100% тёмной стилизацией всех элементов управления."
                               Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,14"/>

                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="STORM-AURORA-FLUID-CERT-2026-RETROARCH-ORIGINAL-AUTHENTIC-BUILD-VERIFIED" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Text="Разработчик: STORM TEAM | 2026" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Закрыть" Style="{StaticResource StormAccentButton}" Width="100" HorizontalAlignment="Right" Click="BtnCloseAbout_Click"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
    </Border>
</Window>
